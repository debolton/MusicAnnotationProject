   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Configuration\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2, json, hashlib, gc, math, itertools\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "ROOT=Path('/content/drive/MyDrive/MusicAnnotationProject')\n",
    "V75_ROOT=ROOT/'reconstruction_geometry_benchmark_v7_5'\n",
    "V79_1_ROOT=ROOT/'observed_ink_preservation_challenger_v7_9_1'\n",
    "SOURCE_RUN=None\n",
    "V75_RUN=None\n",
    "OUTPUT_ROOT=ROOT/'deterministic_gate_calibration_v7_9_2'\n",
    "CONNECTED='v79_connected_dark_d80_w1.75_a12_100'\n",
    "MIN_COMPONENT_AREA=20\n",
    "CONTEXT_RING_RADIUS=18\n",
    "RANDOM_SEED=42\n",
    "N_FOLDS=10\n",
    "\n",
    "# Predeclared asymmetric development objective.\n",
    "FALSE_PIXEL_COST=4.0\n",
    "FALSE_COMPONENT_COST=250.0\n",
    "MIN_SELECTED_COMPONENTS=10\n",
    "MIN_SELECTED_PAGES=3\n",
    "MAX_TRAIN_FALSE_PER_TRUE=0.50\n",
    "MAX_TRAIN_FALSE_COMPONENT_RATE=0.05\n",
    "\n",
    "PROHIBITED=['independent_structural_validation_v7_8_builder','independent_structural_validation_v7_8_rebuilt','independent_policy_validation_v7_8']\n",
    "def assert_dev(path):\n",
    " s=str(Path(path)).lower()\n",
    " if any(x in s for x in PROHIBITED):raise RuntimeError(f'Prohibited independent path: {path}')\n",
    "def latest(root,required):\n",
    " hits=[]\n",
    " if root.exists():\n",
    "  for p in root.rglob('*'):\n",
    "   if p.is_dir() and all((p/x).exists() for x in required):hits.append(p)\n",
    " return max(hits,key=lambda p:p.stat().st_mtime) if hits else None\n",
    "if SOURCE_RUN is None:SOURCE_RUN=latest(V79_1_ROOT,['finalists','stage4_pages','recovery_22a/recovery_manifest.json'])\n",
    "if V75_RUN is None:V75_RUN=latest(V75_ROOT,['tables/cache_status.csv','tables/surrounding_area_evidence_by_component.csv'])\n",
    "if SOURCE_RUN is None or V75_RUN is None:raise RuntimeError('Set SOURCE_RUN and V75_RUN explicitly.')\n",
    "SOURCE_RUN=Path(SOURCE_RUN);V75_RUN=Path(V75_RUN);assert_dev(SOURCE_RUN);assert_dev(V75_RUN)\n",
    "RUN=datetime.now().strftime('%Y%m%d_%H%M%S');OUT=OUTPUT_ROOT/RUN;TABLES=OUT/'tables';ARTEFACTS=OUT/'artefacts'\n",
    "for p in [OUT,TABLES,ARTEFACTS]:p.mkdir(parents=True,exist_ok=False)\n",
    "FINALISTS=SOURCE_RUN/'finalists'\n",
    "print('V7.9.1:',SOURCE_RUN);print('V7.5:',V75_RUN);print('Output:',OUT)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Integrity helpers and development roster\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "SUPPORTED={'.png','.jpg','.jpeg','.tif','.tiff','.bmp'}\n",
    "def imap(folder):return {p.stem:p for p in Path(folder).iterdir() if p.is_file() and p.suffix.lower() in SUPPORTED} if Path(folder).exists() else {}\n",
    "def loadz(path):\n",
    " assert_dev(path)\n",
    " with np.load(path,allow_pickle=False) as z:return {k:z[k] for k in z.files}\n",
    "def sha256_file(path):\n",
    " h=hashlib.sha256()\n",
    " with open(path,'rb') as f:\n",
    "  for b in iter(lambda:f.read(1048576),b''):h.update(b)\n",
    " return h.hexdigest()\n",
    "def object_hash(v):return hashlib.sha256(json.dumps(v,sort_keys=True,default=str,separators=(',',':')).encode()).hexdigest()\n",
    "def array_hash(a):\n",
    " a=np.ascontiguousarray(a);h=hashlib.sha256();h.update(str(a.dtype).encode());h.update(str(a.shape).encode());h.update(a.tobytes());return h.hexdigest()\n",
    "def atomic_json(path,value):\n",
    " t=Path(str(path)+'.tmp');t.write_text(json.dumps(value,indent=2,sort_keys=True,default=str));t.replace(path)\n",
    "def printed_ink(im):return cv2.adaptiveThreshold(im,255,cv2.ADAPTIVE_THRESH_GAUSSIAN_C,cv2.THRESH_BINARY_INV,41,15)>0\n",
    "def edges(im):return cv2.Canny(im,70,170)>0\n",
    "def tolerant(ref,pred,region,tol=1):\n",
    " ref=ref&region;pred=pred&region\n",
    " if not region.any() or not ref.any():return np.nan,np.nan,np.nan\n",
    " k=np.ones((2*tol+1,2*tol+1),np.uint8);rd=cv2.dilate(ref.astype(np.uint8),k)>0;pd=cv2.dilate(pred.astype(np.uint8),k)>0;p=float(np.sum(pred&rd)/max(int(pred.sum()),1));r=float(np.sum(ref&pd)/int(ref.sum()));return p,r,float(2*p*r/max(p+r,1e-12))\n",
    "status=pd.read_csv(V75_RUN/'tables'/'cache_status.csv');cache={str(r.page):Path(r.cache) for _,r in status.iterrows()};clean_map=imap(ROOT/'source'/'clean');observed_map=imap(ROOT/'aligned')\n",
    "pages=sorted(set(cache)&set(clean_map)&set(observed_map))\n",
    "required=[]\n",
    "for page in pages:\n",
    " for candidate in ['v78_baseline',CONNECTED]:required.append(FINALISTS/f'{page}_{candidate}.npz')\n",
    "missing=[str(p) for p in required if not p.exists() or p.stat().st_size==0]\n",
    "if missing:raise RuntimeError(f'Missing saved NPZ files: {missing[:20]}')\n",
    "print('Development pages:',len(pages),'NPZ files:',len(required))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Reconstruct the predictor/delta table from saved arrays\n",
    "\n",
    "Predictors describe the mask component and the challenger increment before truth is consulted. Outcome columns quantify the connected-dark change relative to frozen V7.8 within the same component.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "PREDICTORS=['area','w','h','aspect_ratio','fill_ratio','touches_page_border','context_pixels','context_edge_density','context_dark_density','context_mean_intensity','context_intensity_std','maximum_mask_depth','horizontal_fraction','vertical_fraction','compact_fraction','v78_preserve_fraction','v78_remove_fraction','v78_ambiguous_fraction','added_pixels','added_fraction_of_component','added_to_v78_preserve_ratio','added_component_count','largest_added_component','added_fill_ratio','added_boundary_contact_fraction','support_overlap_fraction']\n",
    "rows=[];audit=[]\n",
    "for pi,page in enumerate(pages,1):\n",
    " clean=cv2.imread(str(clean_map[page]),0);observed=cv2.imread(str(observed_map[page]),0);zref=loadz(cache[page]);mask=zref['mask'];base=loadz(FINALISTS/f'{page}_v78_baseline.npz');chall=loadz(FINALISTS/f'{page}_{CONNECTED}.npz')\n",
    " shape=observed.shape;required_keys={'reconstruction','preserve','remove','ambiguous','glyph'}\n",
    " for name,z in [('v78',base),('connected',chall)]:\n",
    "  miss=required_keys-set(z)\n",
    "  if miss:raise RuntimeError(f'{page} {name}: missing {sorted(miss)}')\n",
    "  if any(z[k].shape!=shape for k in required_keys):raise RuntimeError(f'{page} {name}: shape mismatch')\n",
    "  if not np.array_equal(z['reconstruction'][mask==0],observed[mask==0]):raise RuntimeError(f'{page} {name}: outside-mask drift')\n",
    " m=mask>0;bpres=base['preserve']>0;brem=base['remove']>0;bamb=base['ambiguous']>0;cpres=chall['preserve']>0;added=cpres&~bpres\n",
    " if not np.array_equal((bpres.astype(np.uint8)+brem.astype(np.uint8)+bamb.astype(np.uint8)),m.astype(np.uint8)):raise RuntimeError(f'{page}: baseline partition invalid')\n",
    " clean_ink=printed_ink(clean);clean_edge=edges(clean);brecon_ink=printed_ink(base['reconstruction']);crecon_ink=printed_ink(chall['reconstruction']);brecon_edge=edges(base['reconstruction']);crecon_edge=edges(chall['reconstruction']);edge_obs=edges(observed)\n",
    " n,lab,stats,_=cv2.connectedComponentsWithStats(m.astype(np.uint8),8)\n",
    " for cid in range(1,n):\n",
    "  x,y,w,h,a=[int(v) for v in stats[cid]]\n",
    "  if a<MIN_COMPONENT_AREA:continue\n",
    "  comp=lab==cid;ys,xs=np.where(comp);ring=(cv2.dilate(comp.astype(np.uint8),cv2.getStructuringElement(cv2.MORPH_ELLIPSE,(2*CONTEXT_RING_RADIUS+1,2*CONTEXT_RING_RADIUS+1)))>0)&~comp;vals=observed[ring];depth=cv2.distanceTransform(comp.astype(np.uint8),cv2.DIST_L2,5);add=added&comp\n",
    "  an,al,ast,_=cv2.connectedComponentsWithStats(add.astype(np.uint8),8);areas=[int(ast[j,cv2.CC_STAT_AREA]) for j in range(1,an)];bbox_area=max(w*h,1);boundary=cv2.morphologyEx(comp.astype(np.uint8),cv2.MORPH_GRADIENT,np.ones((3,3),np.uint8))>0\n",
    "  def frac(arr):return float(np.sum(arr&comp)/a)\n",
    "  bip,bir,bif=tolerant(clean_ink,brecon_ink,comp);cip,cir,cif=tolerant(clean_ink,crecon_ink,comp);bep,ber,bef=tolerant(clean_edge,brecon_edge,comp);cep,cer,cef=tolerant(clean_edge,crecon_edge,comp)\n",
    "  bd=np.abs(clean.astype(np.float32)-base['reconstruction'].astype(np.float32));cd=np.abs(clean.astype(np.float32)-chall['reconstruction'].astype(np.float32));tp=int(np.sum(add&clean_ink));fp=int(np.sum(add&~clean_ink))\n",
    "  row={'page':page,'component':cid,'x':x,'y':y,'area':a,'w':w,'h':h,'aspect_ratio':max(w,h)/max(min(w,h),1),'fill_ratio':a/bbox_area,'touches_page_border':bool(x==0 or y==0 or x+w==shape[1] or y+h==shape[0]),'context_pixels':int(ring.sum()),'context_edge_density':float(edge_obs[ring].mean()) if ring.any() else 0.0,'context_dark_density':float((vals<190).mean()) if vals.size else 0.0,'context_mean_intensity':float(vals.mean()) if vals.size else 255.0,'context_intensity_std':float(vals.std()) if vals.size else 0.0,'maximum_mask_depth':float(depth[comp].max()),'horizontal_fraction':frac(zref['g80_horizontal']>0) if 'g80_horizontal' in zref else np.nan,'vertical_fraction':frac(zref['g80_vertical']>0) if 'g80_vertical' in zref else np.nan,'compact_fraction':frac(zref['g80_compact']>0) if 'g80_compact' in zref else np.nan,'v78_preserve_fraction':frac(bpres),'v78_remove_fraction':frac(brem),'v78_ambiguous_fraction':frac(bamb),'added_pixels':int(add.sum()),'added_fraction_of_component':float(add.sum()/a),'added_to_v78_preserve_ratio':float(add.sum()/max(int(np.sum(bpres&comp)),1)),'added_component_count':len(areas),'largest_added_component':max(areas,default=0),'added_fill_ratio':float(add.sum()/bbox_area),'added_boundary_contact_fraction':float(np.sum(add&boundary)/max(int(add.sum()),1)),'support_overlap_fraction':float(np.sum(add&((zref.get('g80_horizontal',0)>0)|(zref.get('g80_vertical',0)>0)|(zref.get('g80_compact',0)>0)))/max(int(add.sum()),1)),'added_true_print':tp,'added_false_annotation':fp,'added_precision_truth':tp/max(tp+fp,1),'delta_ink_recall':cir-bir if np.isfinite(cir) and np.isfinite(bir) else np.nan,'delta_ink_f1':cif-bif if np.isfinite(cif) and np.isfinite(bif) else np.nan,'delta_edge_f1':cef-bef if np.isfinite(cef) and np.isfinite(bef) else np.nan,'delta_mae':float(cd[comp].mean()-bd[comp].mean()),'beneficial':bool(tp>0 and fp<=tp and (not np.isfinite(cif-bif) or cif-bif>=0)),'catastrophic':bool(fp>max(25,4*tp) or (np.isfinite(cif-bif) and cif-bif<=-0.20))}\n",
    "  rows.append(row)\n",
    " audit.append({'page':page,'mask_sha256':array_hash(mask),'baseline_npz_sha256':sha256_file(FINALISTS/f'{page}_v78_baseline.npz'),'connected_npz_sha256':sha256_file(FINALISTS/f'{page}_{CONNECTED}.npz'),'components':sum(1 for j in range(1,n) if stats[j,cv2.CC_STAT_AREA]>=MIN_COMPONENT_AREA)})\n",
    " print('Extracted',pi,'/',len(pages),page);del clean,observed,zref,base,chall;gc.collect()\n",
    "df=pd.DataFrame(rows);df.to_csv(TABLES/'v7_9_2_component_predictor_delta_table.csv',index=False);pd.DataFrame(audit).to_csv(TABLES/'input_npz_audit.csv',index=False)\n",
    "if not len(df) or df.page.nunique()!=len(pages):raise RuntimeError('Incomplete component table.')\n",
    "print('Components:',len(df),'Pages:',df.page.nunique());display(df[PREDICTORS+['added_true_print','added_false_annotation','beneficial','catastrophic']].describe().T)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
     "# Repair the erroneous Notebook 22b completeness check.\n",
     "#\n",
     "# A processed page may validly contain zero mask components meeting\n",
     "# MIN_COMPONENT_AREA. Completeness therefore means:\n",
     "#\n",
     "# 1. every page has an audit row;\n",
     "# 2. the extracted component-row count equals the sum of the audited\n",
     "#    retained-component counts;\n",
     "# 3. every page's extracted count matches its audited count.\n",
     "\n",
     "df = pd.DataFrame(rows)\n",
     "audit_df = pd.DataFrame(audit)\n",
     "\n",
     "\n",
     "# ------------------------------------------------------------\n",
     "# Confirm that all development pages were processed\n",
     "# ------------------------------------------------------------\n",
     "\n",
     "expected_pages = set(map(str, pages))\n",
     "audited_pages = set(\n",
     "    audit_df["page"].astype(str)\n",
     ")\n",
     "\n",
     "if len(audit_df) != len(pages):\n",
     "    raise RuntimeError(\n",
     "        "Incomplete page audit: "\n",
     "        f"expected {len(pages)} page rows, "\n",
     "        f"found {len(audit_df)}."\n",
     "    )\n",
     "\n",
     "if audited_pages != expected_pages:\n",
     "    raise RuntimeError(\n",
     "        "Incomplete page audit roster. "\n",
     "        f"Missing: {sorted(expected_pages - audited_pages)}; "\n",
     "        f"unexpected: {sorted(audited_pages - expected_pages)}"\n",
     "    )\n",
     "\n",
     "\n",
     "# ------------------------------------------------------------\n",
     "# Confirm the total component-row count\n",
     "# ------------------------------------------------------------\n",
     "\n",
     "expected_components = int(\n",
     "    audit_df["components"].sum()\n",
     ")\n",
     "\n",
     "actual_components = len(df)\n",
     "\n",
     "if actual_components != expected_components:\n",
     "    raise RuntimeError(\n",
     "        "Incomplete component table: "\n",
     "        f"expected {expected_components} rows from the page audit, "\n",
     "        f"found {actual_components}."\n",
     "    )\n",
     "\n",
     "if expected_components == 0:\n",
     "    raise RuntimeError(\n",
     "        "No retained components exist on the development roster."\n",
     "    )\n",
     "\n",
     "\n",
     "# ------------------------------------------------------------\n",
     "# Confirm each page separately\n",
     "# ------------------------------------------------------------\n",
     "\n",
     "actual_by_page = (\n",
     "    df.groupby("page")\n",
     "    .size()\n",
     "    .to_dict()\n",
     ")\n",
     "\n",
     "audit_df["extracted_component_rows"] = (\n",
     "    audit_df["page"]\n",
     "    .map(actual_by_page)\n",
     "    .fillna(0)\n",
     "    .astype(int)\n",
     ")\n",
     "\n",
     "audit_df["component_count_matches"] = (\n",
     "    audit_df["components"].astype(int)\n",
     "    == audit_df["extracted_component_rows"]\n",
     ")\n",
     "\n",
     "mismatched_pages = audit_df[\n",
     "    ~audit_df["component_count_matches"]\n",
     "]\n",
     "\n",
     "if not mismatched_pages.empty:\n",
     "    display(\n",
     "        mismatched_pages[\n",
     "            [\n",
     "                "page",\n",
     "                "components",\n",
     "                "extracted_component_rows",\n",
     "            ]\n",
     "        ]\n",
     "    )\n",
     "\n",
     "    raise RuntimeError(\n",
     "        "One or more per-page component counts "\n",
     "        "do not match the extraction audit."\n",
     "    )\n",
     "\n",
     "\n",
     "# ------------------------------------------------------------\n",
     "# Record pages that legitimately have no retained components\n",
     "# ------------------------------------------------------------\n",
     "\n",
     "zero_component_pages = (\n",
     "    audit_df.loc[\n",
     "        audit_df["components"].astype(int) == 0,\n",
     "        "page",\n",
     "    ]\n",
     "    .astype(str)\n",
     "    .tolist()\n",
     ")\n",
     "\n",
     "zero_component_df = pd.DataFrame({\n",
     "    "page": zero_component_pages,\n",
     "    "reason": (\n",
     "        "No mask component met MIN_COMPONENT_AREA"\n",
     "    ),\n",
     "})\n",
     "\n",
     "\n",
     "# ------------------------------------------------------------\n",
     "# Rewrite the extraction outputs with the enhanced audit\n",
     "# ------------------------------------------------------------\n",
     "\n",
     "df.to_csv(\n",
     "    TABLES\n",
     "    / "v7_9_2_component_predictor_delta_table.csv",\n",
     "    index=False,\n",
     ")\n",
     "\n",
     "audit_df.to_csv(\n",
     "    TABLES\n",
     "    / "input_npz_audit.csv",\n",
     "    index=False,\n",
     ")\n",
     "\n",
     "zero_component_df.to_csv(\n",
     "    TABLES\n",
     "    / "pages_without_retained_components.csv",\n",
     "    index=False,\n",
     ")\n",
     "\n",
     "\n",
     "print(\n",
     "    "Processed pages:",\n",
     "    len(audit_df),\n",
     ")\n",
     "\n",
     "print(\n",
     "    "Component-bearing pages:",\n",
     "    df["page"].nunique(),\n",
     ")\n",
     "\n",
     "print(\n",
     "    "Retained components:",\n",
     "    len(df),\n",
     ")\n",
     "\n",
     "print(\n",
     "    "Pages without retained components:",\n",
     "    len(zero_component_pages),\n",
     ")\n",
     "\n",
     "print(\n",
     "    "Zero-component pages:",\n",
     "    zero_component_pages,\n",
     ")\n",
     "\n",
     "\n",
     "display(\n",
     "    df[\n",
     "        PREDICTORS\n",
     "        + [\n",
     "            "added_true_print",\n",
     "            "added_false_annotation",\n",
     "            "beneficial",\n",
     "            "catastrophic",\n",
     "        ]\n",
     "    ]\n",
     "    .describe()\n",
     "    .T\n",
     ")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Deterministic candidate gates\n",
    "\n",
    "The search uses only simple conjunctions over pre-truth predictors. Threshold values are derived from fixed quantile grids on each training fold. No model is fitted.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "GATE_FIELDS=['maximum_mask_depth','added_fraction_of_component','added_to_v78_preserve_ratio','added_pixels','added_fill_ratio','context_edge_density','support_overlap_fraction','v78_preserve_fraction']\n",
    "def quantiles(series,qs):return sorted(set(float(series.quantile(q)) for q in qs if np.isfinite(series.quantile(q))))\n",
    "def candidate_rules(train):\n",
    " grids={\n",
    "  'maximum_mask_depth':quantiles(train.maximum_mask_depth,[.25,.5,.75,.9]),\n",
    "  'added_fraction_of_component':quantiles(train.added_fraction_of_component,[.25,.5,.75,.9]),\n",
    "  'added_to_v78_preserve_ratio':quantiles(train.added_to_v78_preserve_ratio,[.25,.5,.75,.9]),\n",
    "  'added_pixels':quantiles(train.added_pixels,[.25,.5,.75,.9]),\n",
    "  'added_fill_ratio':quantiles(train.added_fill_ratio,[.25,.5,.75,.9]),\n",
    "  'context_edge_density':quantiles(train.context_edge_density,[.1,.25,.5,.75]),\n",
    "  'support_overlap_fraction':quantiles(train.support_overlap_fraction,[.1,.25,.5,.75]),\n",
    "  'v78_preserve_fraction':quantiles(train.v78_preserve_fraction,[.1,.25,.5,.75]),\n",
    " }\n",
    " rules=[]\n",
    " for depth,af,ratio,pixels,fill,edge,support,preserve in itertools.product(*[grids[k] for k in GATE_FIELDS]):\n",
    "  rules.append({'maximum_mask_depth_max':depth,'added_fraction_of_component_max':af,'added_to_v78_preserve_ratio_max':ratio,'added_pixels_max':pixels,'added_fill_ratio_max':fill,'context_edge_density_min':edge,'support_overlap_fraction_min':support,'v78_preserve_fraction_min':preserve,'reject_page_border':True})\n",
    " return rules\n",
    "def apply_rule(frame,r):\n",
    " return (~frame.touches_page_border.astype(bool))&(frame.maximum_mask_depth<=r['maximum_mask_depth_max'])&(frame.added_fraction_of_component<=r['added_fraction_of_component_max'])&(frame.added_to_v78_preserve_ratio<=r['added_to_v78_preserve_ratio_max'])&(frame.added_pixels<=r['added_pixels_max'])&(frame.added_fill_ratio<=r['added_fill_ratio_max'])&(frame.context_edge_density>=r['context_edge_density_min'])&(frame.support_overlap_fraction>=r['support_overlap_fraction_min'])&(frame.v78_preserve_fraction>=r['v78_preserve_fraction_min'])&(frame.added_pixels>0)\n",
    "def score(frame,selected):\n",
    " tp=int(frame.loc[selected,'added_true_print'].sum());fp=int(frame.loc[selected,'added_false_annotation'].sum());n=int(selected.sum());bad=int(frame.loc[selected,'catastrophic'].sum());pages=int(frame.loc[selected,'page'].nunique());false_rate=bad/max(n,1);ratio=fp/max(tp,1);utility=tp-FALSE_PIXEL_COST*fp-FALSE_COMPONENT_COST*bad\n",
    " return {'selected_components':n,'selected_pages':pages,'added_true_print':tp,'added_false_annotation':fp,'false_per_true':ratio,'catastrophic_selected':bad,'catastrophic_rate':false_rate,'utility':utility}\n",
    "def choose_rule(train):\n",
    " best=None;records=[]\n",
    " for r in candidate_rules(train):\n",
    "  q=score(train,apply_rule(train,r));rec={**r,**q};records.append(rec)\n",
    "  eligible=q['selected_components']>=MIN_SELECTED_COMPONENTS and q['selected_pages']>=MIN_SELECTED_PAGES and q['false_per_true']<=MAX_TRAIN_FALSE_PER_TRUE and q['catastrophic_rate']<=MAX_TRAIN_FALSE_COMPONENT_RATE\n",
    "  if eligible and (best is None or (q['utility'],q['added_true_print'],-q['added_false_annotation'])>(best['utility'],best['added_true_print'],-best['added_false_annotation'])):best=rec\n",
    " if best is None:\n",
    "  # Fail closed to a gate selecting nothing.\n",
    "  best={'maximum_mask_depth_max':-1.0,'added_fraction_of_component_max':0.0,'added_to_v78_preserve_ratio_max':0.0,'added_pixels_max':0.0,'added_fill_ratio_max':0.0,'context_edge_density_min':1.1,'support_overlap_fraction_min':1.1,'v78_preserve_fraction_min':1.1,'reject_page_border':True,**score(train,np.zeros(len(train),dtype=bool))}\n",
    " return best,pd.DataFrame(records)\n"
   ]
