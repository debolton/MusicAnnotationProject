cells=[] cells.append(md(''' # Music Annotation Project ## Notebook 77B: Direct Notebook-75 Pixel Join Audit of the Locked Notebook-77 Paper Veto This notebook replaces the failed reconstructed scorer in Notebook 77A. ### Purpose Use Notebook 75's own persisted `paired_selected_pixels.parquet` as the authoritative C1 scoring population, then join Notebook 77's already-locked `PAPER_SUPPORTED` mask directly by page/y/x. There is **no reconstruction of Notebook 75 truth** and no refitting, threshold movement, clean-image inference, or policy change. ### Required gates 1. Verify the completed Notebook 77 prediction lock and locked `paper_supported` maps. 2. Discover and validate the actual schema of Notebook 75 `paired_selected_pixels.parquet`. 3. Isolate the C1 / Ring-2 authoritative rows. 4. Reproduce the published Notebook 75 C1 totals from that table. 5. Join `PAPER_SUPPORTED` by exact coordinate. 6. Recalculate the A2 counterfactual by simply removing vetoed C1 rows. 7. Report whether A2 removes annotation while preserving C1 PRINT. ### Interpretation If the paper veto removes no C1 PRINT rows and removes one or more C1 ANNOTATION rows, A2 is a strict development improvement over C1 on this frozen evidence. If PRINT is vetoed too, the affected rows/pages/components are written for visual review rather than being hidden inside an aggregate. ''')) cells.append(code(''' from google.colab import drive drive.mount('/content/drive') !pip install -q pandas numpy pyarrow matplotlib seaborn opencv-python-headless ''')) cells.append(md('## 1. Configuration and source-run resolution')) cells.append(code(r''' from pathlib import Path from datetime import datetime, timezone import json, hashlib, shutil, zipfile import numpy as np import pandas as pd import cv2 import matplotlib.pyplot as plt import seaborn as sns ROOT=Path('/content/drive/MyDrive/MusicAnnotationProject') NB75_ROOT=ROOT/'notebook75_v88_collar_preservation_counterfactual' NB75A_ROOT=ROOT/'notebook75a_stratified_reanalysis' NB77_ROOT=ROOT/'notebook77_observable_paper_veto' OUTPUT_ROOT=ROOT/'notebook77b_direct_pixel_join_audit' SOURCE_NB75_RUN_OVERRIDE=None SOURCE_NB75A_RUN_OVERRIDE=None SOURCE_NB77_RUN_OVERRIDE=None EXPECTED_C1_PRINT=18178 EXPECTED_C1_ANNOTATION=1246 EXPECTED_C1_CATASTROPHES=1 EXPECTED_C1_UTILITY=11448 BOOTSTRAP_RESAMPLES=10000 SEED=42 RUN=datetime.now().strftime('%Y%m%d_%H%M%S')+'_notebook77b_direct_pixel_join' OUT=OUTPUT_ROOT/RUN TABLES=OUT/'tables'; AUDIT=OUT/'audit'; VISUALS=OUT/'visuals'; REVIEW=OUT/'review'; UPLOAD=OUT/'upload' for p in [OUT,TABLES,AUDIT,VISUALS,REVIEW,UPLOAD]: p.mkdir(parents=True,exist_ok=False) def require(x,msg): if not bool(x): raise RuntimeError(msg) def sha256_file(path): h=hashlib.sha256() with open(path,'rb') as f: for b in iter(lambda:f.read(1048576),b''): h.update(b) return h.hexdigest() def atomic_json(path,x): t=Path(str(path)+'.tmp'); t.write_text(json.dumps(x,indent=2,sort_keys=True,default=str)); t.replace(path) def objhash(x): return hashlib.sha256(json.dumps(x,sort_keys=True,default=str,separators=(',',':')).encode()).hexdigest() def latest(root,required): hits=[] if Path(root).exists(): for p in Path(root).rglob('*'): if p.is_dir() and all((p/r).exists() for r in required): hits.append(p) return max(hits,key=lambda p:p.stat().st_mtime) if hits else None NB75=Path(SOURCE_NB75_RUN_OVERRIDE) if SOURCE_NB75_RUN_OVERRIDE else latest(NB75_ROOT,[ 'tables/paired_selected_pixels.parquet','tables/results_by_page.csv','prediction_lock/prediction_lock.json']) NB75A=Path(SOURCE_NB75A_RUN_OVERRIDE) if SOURCE_NB75A_RUN_OVERRIDE else latest(NB75A_ROOT,[ 'tables/page_role_resolution.csv','tables/collar_exposed_arm_summary.csv']) NB77=Path(SOURCE_NB77_RUN_OVERRIDE) if SOURCE_NB77_RUN_OVERRIDE else latest(NB77_ROOT,[ 'prediction_lock.json','observable_maps','audit/page_output_hashes.csv']) require(NB75 is not None,'No complete Notebook 75 run with paired_selected_pixels.parquet found.') require(NB75A is not None,'No complete Notebook 75A run found.') require(NB77 is not None,'No complete Notebook 77 run found.') print('Notebook 75 :',NB75) print('Notebook 75A:',NB75A) print('Notebook 77 :',NB77) print('Notebook 77B:',OUT) ''')) cells.append(md('## 2. Verify the durable source identities and Notebook 77 lock')) cells.append(code(r''' PARQUET=NB75/'tables'/'paired_selected_pixels.parquet' LOCK77=NB77/'prediction_lock.json' HASH77=NB77/'audit'/'page_output_hashes.csv' require(PARQUET.exists(),f'Missing {PARQUET}') require(LOCK77.exists(),f'Missing {LOCK77}') require(HASH77.exists(),f'Missing {HASH77}') lock77=json.loads(LOCK77.read_text()) require(lock77.get('state')=='OBSERVABLE_DECISIONS_LOCKED_BEFORE_TRUTH', f'Unexpected Notebook 77 lock state: {lock77.get("state")}') hashes77=pd.read_csv(HASH77) source_identity={ 'notebook75':str(NB75),'notebook75a':str(NB75A),'notebook77':str(NB77), 'notebook75_pixel_table_sha256':sha256_file(PARQUET), 'notebook75_results_by_page_sha256':sha256_file(NB75/'tables'/'results_by_page.csv'), 'notebook75a_roles_sha256':sha256_file(NB75A/'tables'/'page_role_resolution.csv'), 'notebook77_prediction_lock_sha256':sha256_file(LOCK77), 'notebook77_lock_id':lock77.get('lock_id'), 'notebook77_page_hashes_sha256':sha256_file(HASH77), } atomic_json(AUDIT/'source_identity.json',source_identity) print(json.dumps(source_identity,indent=2)) ''')) cells.append(md('''## 3. Inspect and normalize the actual Notebook-75 pixel-table schema The notebook does not assume the exact column spelling beyond a small set of semantic aliases. It writes the detected mapping and fails closed if page/y/x, arm or truth class cannot be resolved unambiguously.''')) cells.append(code(r''' pix=pd.read_parquet(PARQUET) print('Shape:',pix.shape) print('Columns:',pix.columns.tolist()) print(pix.head(8).to_string(index=False)) ALIASES={ 'page_key':['page_key','runtime_page','key'], 'page':['page','page_id','page_name'], 'source_group':['source_group','group'], 'arm':['arm','candidate_arm','treatment'], 'y':['y','row'], 'x':['x','col','column'], 'ring':['ring','authority_ring','band'], 'truth_class':['truth_class','truth','class','label'], 'observed':['observed','observed_value'], 'incumbent':['incumbent','baseline','c0'], 'candidate':['candidate','candidate_value'], } def resolve_col(name,required=True): hits=[c for c in ALIASES[name] if c in pix.columns] if len(hits)==1:return hits[0] if len(hits)>1:raise RuntimeError(f'Ambiguous {name} columns: {hits}') if required:raise RuntimeError(f'Cannot resolve required {name}; aliases={ALIASES[name]}') return None mapping={k:resolve_col(k,required=k in {'page','arm','y','x','truth_class'}) for k in ALIASES} atomic_json(AUDIT/'pixel_table_schema_mapping.json',mapping) print('Resolved:',json.dumps(mapping,indent=2)) # Canonical in-memory names. ren={v:k for k,v in mapping.items() if v is not None and v!=k} pix=pix.rename(columns=ren) pix['page']=pix['page'].astype(str); pix['arm']=pix['arm'].astype(str); pix['truth_class']=pix['truth_class'].astype(str).str.upper() pix['y']=pd.to_numeric(pix['y'],errors='raise').astype(int);pix['x']=pd.to_numeric(pix['x'],errors='raise').astype(int) if 'page_key' not in pix.columns: # Resolve page_key from Notebook 75 page-level table only if page identity is unique. r75=pd.read_csv(NB75/'tables'/'results_by_page.csv') mapq=r75[['page_key','page']].drop_duplicates() require(not mapq.page.duplicated().any(),'Cannot derive page_key: Notebook75 page names are not unique.') pix=pix.merge(mapq,on='page',how='left',validate='many_to_one') require(pix.page_key.notna().all(),'Some pixel rows could not resolve page_key.') pix['page_key']=pix['page_key'].astype(str) if 'source_group' not in pix.columns: r75=pd.read_csv(NB75/'tables'/'results_by_page.csv') g=r75[['page_key','source_group']].drop_duplicates('page_key');pix=pix.merge(g,on='page_key',how='left',validate='many_to_one') print('\nArm counts:\n',pix.arm.value_counts(dropna=False).to_string()) print('\nTruth counts:\n',pix.truth_class.value_counts(dropna=False).to_string()) ''')) cells.append(md('## 4. Isolate authoritative C1 rows and prove Notebook-75 totals')) cells.append(code(r''' # Robust arm recognition: exact expected label first, then a single unambiguous C1/RING2 label. arms=sorted(pix.arm.unique()) if 'C1_PRESERVE_RING2' in arms: c1_label='C1_PRESERVE_RING2' elif 'C1_RING2' in arms: c1_label='C1_RING2' else: candidates=[a for a in arms if 'C1' in a.upper() and 'RING2' in a.upper()] require(len(candidates)==1,f'Cannot uniquely identify C1 arm from {arms}') c1_label=candidates[0] c1=pix[pix.arm.eq(c1_label)].copy() # If the table includes both rings or non-restored rows, use ring identity when available. if 'ring' in c1.columns and c1['ring'].notna().any(): vals=set(c1.ring.dropna().astype(str).str.upper()) if 'RING2' in vals:c1=c1[c1.ring.astype(str).str.upper().eq('RING2')].copy() require(len(c1)>0,'No authoritative C1 rows after filtering.') require(not c1.duplicated(['page_key','y','x']).any(),'Duplicate C1 page/y/x rows in authoritative pixel table.') counts=c1.truth_class.value_counts().to_dict() print('C1 truth counts:',counts) # Notebook 75 may store OTHER rows in addition to the scored categories. Only registered truth classes are primary. actual_print=int(counts.get('PRINT',0));actual_ann=int(counts.get('ANNOTATION',0));actual_unc=int(counts.get('UNCERTAIN',0)) reference_gate={ 'c1_label':c1_label,'rows':len(c1),'PRINT':actual_print,'ANNOTATION':actual_ann,'UNCERTAIN':actual_unc, 'expected_PRINT':EXPECTED_C1_PRINT,'expected_ANNOTATION':EXPECTED_C1_ANNOTATION, 'print_total_exact':actual_print==EXPECTED_C1_PRINT, 'annotation_total_exact':actual_ann==EXPECTED_C1_ANNOTATION, } atomic_json(AUDIT/'notebook75_pixel_reference_gate.json',reference_gate) require(reference_gate['print_total_exact'] and reference_gate['annotation_total_exact'], 'Notebook75 parquet does not reproduce declared C1 PRINT/ANNOTATION totals. Stop and inspect audit/notebook75_pixel_reference_gate.json') print('Notebook75 authoritative pixel table reproduces C1 PRINT and ANNOTATION totals exactly.') ''')) cells.append(md('## 5. Verify Notebook-77 paper maps and join them directly by page/y/x')) cells.append(code(r''' # Verify each locked paper map against Notebook77 page hashes before joining. required_hash={'page_key','paper_array_sha256'} require(required_hash.issubset(hashes77.columns),f'Notebook77 hashes missing {required_hash-set(hashes77.columns)}') hash_lookup=hashes77.set_index('page_key') joined_parts=[];map_checks=[] for key,g in c1.groupby('page_key',sort=False): require(key in hash_lookup.index,f'{key}: absent from Notebook77 hash table') mp=NB77/'observable_maps'/f'{key}.npz';require(mp.exists(),f'{key}: missing locked observable map') with np.load(mp) as z: require('paper_supported' in z.files,f'{key}: paper_supported absent') paper=z['paper_supported']>0 ah=array_hash(paper.astype(np.uint8));expected=str(hash_lookup.loc[key,'paper_array_sha256']) require(ah==expected,f'{key}: paper_supported hash mismatch') yy=g.y.to_numpy();xx=g.x.to_numpy();require((yy>=0).all() and (xx>=0).all() and (yy<paper.shape[0]).all() and (xx<paper.shape[1]).all(),f'{key}: C1 coordinate outside paper map') q=g.copy();q['paper_veto']=paper[yy,xx];joined_parts.append(q) map_checks.append({'page_key':key,'rows':len(g),'paper_map_sha256':ah,'vetoed_c1_rows':int(q.paper_veto.sum())}) joined=pd.concat(joined_parts,ignore_index=True) pd.DataFrame(map_checks).to_csv(AUDIT/'paper_map_join_checks.csv',index=False) joined.to_parquet(TABLES/'c1_pixels_with_locked_paper_veto.parquet',index=False) print(pd.crosstab(joined.paper_veto,joined.truth_class,margins=True)) ''')) cells.append(md('## 6. Exact A2 counterfactual from the direct join')) cells.append(code(r''' # A2 retains all C1 authoritative rows except coordinates vetoed by locked PAPER_SUPPORTED. a2=joined[~joined.paper_veto].copy();vetoed=joined[joined.paper_veto].copy() def truth_counts(df): q=df.truth_class.value_counts();return {k:int(q.get(k,0)) for k in ['PRINT','ANNOTATION','UNCERTAIN','OTHER']} c1_counts=truth_counts(joined);a2_counts=truth_counts(a2);veto_counts=truth_counts(vetoed) comparison={ 'C1':c1_counts, 'A2':a2_counts, 'VETOED_FROM_C1':veto_counts, 'c1_rows':int(len(joined)),'a2_rows':int(len(a2)),'vetoed_rows':int(len(vetoed)), 'true_print_delta':int(a2_counts['PRINT']-c1_counts['PRINT']), 'annotation_delta':int(a2_counts['ANNOTATION']-c1_counts['ANNOTATION']), 'uncertain_delta':int(a2_counts['UNCERTAIN']-c1_counts['UNCERTAIN']), 'true_print_retention':float(a2_counts['PRINT']/max(c1_counts['PRINT'],1)), 'annotation_retention':float(a2_counts['ANNOTATION']/max(c1_counts['ANNOTATION'],1)), 'strict_dominance_on_registered_print_annotation':bool(veto_counts['PRINT']==0 and veto_counts['ANNOTATION']>0), } atomic_json(TABLES/'direct_A2_vs_C1_comparison.json',comparison) print(json.dumps(comparison,indent=2)) ''')) cells.append(md('## 7. Page, source-group and annotator/style breakdown')) cells.append(code(r''' def agg(df,name): q=df.groupby(['page_key','page','source_group']).truth_class.value_counts().unstack(fill_value=0).reset_index() for c in ['PRINT','ANNOTATION','UNCERTAIN','OTHER']: if c not in q:q[c]=0 q['population']=name;return q page_c1=agg(joined,'C1');page_a2=agg(a2,'A2');page_veto=agg(vetoed,'VETOED') page_table=pd.concat([page_c1,page_a2,page_veto],ignore_index=True);page_table.to_csv(TABLES/'direct_join_by_page.csv',index=False) group=page_table.groupby(['source_group','population'],as_index=False)[['PRINT','ANNOTATION','UNCERTAIN','OTHER']].sum();group.to_csv(TABLES/'direct_join_by_source_group.csv',index=False) manifest=ROOT/'development_score_manifest.csv' if manifest.exists(): m=pd.read_csv(manifest,dtype=str).fillna('') if 'acquisition_notes' in m.columns: ann=m[['page','acquisition_notes']].drop_duplicates('page').rename(columns={'acquisition_notes':'annotator'}) byann=page_table.merge(ann,on='page',how='left').groupby(['annotator','population'],as_index=False)[['PRINT','ANNOTATION','UNCERTAIN','OTHER']].sum();byann.to_csv(TABLES/'direct_join_by_annotator.csv',index=False);print(byann.to_string(index=False)) print(group.to_string(index=False)) ''')) cells.append(md('## 8. Catastrophic-component audit using Notebook-75 component evidence where available')) cells.append(code(r''' component_path=NB75/'tables'/'results_by_component.csv' cat_record={'method':'not available','c1_reference_catastrophes':EXPECTED_C1_CATASTROPHES} if component_path.exists(): comp=pd.read_csv(component_path) # Direct truth-row join is authoritative for pixel classes; component table is used only to identify historical catastrophic C1 cases. ccols=set(comp.columns) if {'arm','page_key','catastrophic'}.issubset(ccols): ca=comp[(comp.arm.astype(str).str.contains('C1')) & comp.catastrophic.astype(bool)].copy() cat_record={'method':'Notebook75 results_by_component historical catastrophe table','historical_catastrophic_components':int(len(ca)),'historical_catastrophic_pages':sorted(ca.page_key.astype(str).unique().tolist())} ca.to_csv(TABLES/'historical_c1_catastrophic_components.csv',index=False) # Report whether the locked paper veto touches PRINT/ANNOTATION rows on those pages. if len(ca): pages=set(ca.page_key.astype(str));q=vetoed[vetoed.page_key.astype(str).isin(pages)];cat_record['vetoed_truth_on_catastrophe_pages']=truth_counts(q) atomic_json(TABLES/'catastrophe_audit.json',cat_record) print(json.dumps(cat_record,indent=2)) ''')) cells.append(md('## 9. Corrected visuals')) cells.append(code(r''' sns.set_theme(style='whitegrid') # True registered Notebook75 classes only. plot=pd.DataFrame([ {'arm':'C1 Ring2','PRINT':c1_counts['PRINT'],'ANNOTATION':c1_counts['ANNOTATION'],'UNCERTAIN':c1_counts['UNCERTAIN']}, {'arm':'A2 Paper veto','PRINT':a2_counts['PRINT'],'ANNOTATION':a2_counts['ANNOTATION'],'UNCERTAIN':a2_counts['UNCERTAIN']}, {'arm':'Vetoed from C1','PRINT':veto_counts['PRINT'],'ANNOTATION':veto_counts['ANNOTATION'],'UNCERTAIN':veto_counts['UNCERTAIN']}, ]) x=np.arange(len(plot));fig,ax=plt.subplots(figsize=(10,6));ax.bar(x-.25,plot.PRINT,.25,label='PRINT');ax.bar(x,plot.ANNOTATION,.25,label='ANNOTATION');ax.bar(x+.25,plot.UNCERTAIN,.25,label='UNCERTAIN');ax.set_xticks(x,plot.arm);ax.set_title('Direct Notebook75 pixel join: C1 versus locked A2 paper veto');ax.legend();plt.tight_layout();plt.savefig(VISUALS/'direct_join_arm_truth_counts.png',dpi=180);plt.close(fig) # Per-page annotation removed versus print removed. c1p=page_c1.set_index('page_key');a2p=page_a2.set_index('page_key');keys=c1p.index.intersection(a2p.index) q=pd.DataFrame({'page_key':keys,'print_removed':(c1p.loc[keys,'PRINT']-a2p.loc[keys,'PRINT']).to_numpy(),'annotation_removed':(c1p.loc[keys,'ANNOTATION']-a2p.loc[keys,'ANNOTATION']).to_numpy(),'uncertain_removed':(c1p.loc[keys,'UNCERTAIN']-a2p.loc[keys,'UNCERTAIN']).to_numpy()}) q.to_csv(TABLES/'paper_veto_effect_by_page.csv',index=False) plt.figure(figsize=(9,7));sns.scatterplot(data=q,x='print_removed',y='annotation_removed',size='uncertain_removed',sizes=(25,220),alpha=.8);plt.axvline(0,color='black',linewidth=1);plt.title('Locked A2 paper veto: direct effect by page');plt.tight_layout();plt.savefig(VISUALS/'paper_veto_effect_by_page.png',dpi=180);plt.close() ''')) cells.append(md('## 10. Verdict')) cells.append(code(r''' if comparison['strict_dominance_on_registered_print_annotation']: interpretation='The locked Notebook 77 A2 paper veto is a strict development improvement over C1 on Notebook 75 authoritative PRINT/ANNOTATION rows: it vetoes retained annotation and vetoes zero registered PRINT pixels. Proceed with A2 rather than blanket C1 to the next visual/shadow validation stage, while retaining uncertainty and catastrophic-case review.' elif veto_counts['PRINT']>0 and veto_counts['ANNOTATION']>0: interpretation='The locked A2 veto removes both annotation and registered PRINT. It is a trade-off, not a strict improvement. Inspect the affected PRINT rows/pages visually before choosing A2 over C1.' elif veto_counts['ANNOTATION']==0: interpretation='The locked A2 veto removes no registered Notebook75 annotation. It adds complexity without the intended benefit; retain C1.' else: interpretation='The direct join gives an indeterminate result. Inspect the truth table and affected coordinates before any policy decision.' verdict={'created_utc':datetime.now(timezone.utc).isoformat(),'version':'notebook77b-direct-notebook75-pixel-join','source_notebook75':str(NB75),'source_notebook77':str(NB77),'source_notebook77_lock_id':lock77.get('lock_id'),'notebook75_pixel_table_sha256':sha256_file(PARQUET),'notebook75_reference_gate':reference_gate,'comparison':comparison,'catastrophe_audit':cat_record,'interpretation':interpretation,'observable_decisions_rebuilt':False,'truth_reconstructed':False,'operator_changed':False,'promotion_authority':False} atomic_json(OUT/'notebook77b_verdict.json',verdict) lines=['NOTEBOOK 77B — DIRECT NOTEBOOK75 PIXEL JOIN AUDIT','',f'Notebook75: {NB75}',f'Notebook77: {NB77}',f'Notebook77 lock: {lock77.get("lock_id")}',f'Authoritative pixel rows: {len(joined):,}','',json.dumps(comparison,indent=2),'','INTERPRETATION',interpretation,'','No Notebook77 decision was rebuilt. No Notebook75 truth was reconstructed from images.'] (OUT/'executive_summary.txt').write_text('\n'.join(lines));print('\n'.join(lines)) ''')) cells.append(md('## 11. Final upload package')) cells.append(code(r''' artefacts=[ OUT/'executive_summary.txt',OUT/'notebook77b_verdict.json', AUDIT/'source_identity.json',AUDIT/'pixel_table_schema_mapping.json',AUDIT/'notebook75_pixel_reference_gate.json',AUDIT/'paper_map_join_checks.csv', TABLES/'direct_A2_vs_C1_comparison.json',TABLES/'direct_join_by_page.csv',TABLES/'direct_join_by_source_group.csv',TABLES/'paper_veto_effect_by_page.csv',TABLES/'catastrophe_audit.json', VISUALS/'direct_join_arm_truth_counts.png',VISUALS/'paper_veto_effect_by_page.png' ] if (TABLES/'direct_join_by_annotator.csv').exists(): artefacts.append(TABLES/'direct_join_by_annotator.csv') if (TABLES/'historical_c1_catastrophic_components.csv').exists(): artefacts.append(TABLES/'historical_c1_catastrophic_components.csv') for p in artefacts: require(p.exists(),f'Missing upload artefact: {p}');shutil.copy2(p,UPLOAD/p.name) (UPLOAD/'README.txt').write_text('Notebook77B directly joins Notebook77 locked PAPER_SUPPORTED coordinates onto Notebook75 paired_selected_pixels.parquet. It does not reconstruct Notebook75 truth. Start with executive_summary.txt, notebook75_pixel_reference_gate.json, direct_A2_vs_C1_comparison.json, direct_join_arm_truth_counts.png and catastrophe_audit.json.\n') manifest=[] for p in sorted(UPLOAD.iterdir()): if p.is_file():manifest.append({'file':p.name,'bytes':p.stat().st_size,'sha256':sha256_file(p)}) pd.DataFrame(manifest).to_csv(UPLOAD/'upload_manifest.csv',index=False) zip_path=UPLOAD/'notebook77b_direct_pixel_join_bundle.zip' with zipfile.ZipFile(zip_path,'w',zipfile.ZIP_DEFLATED) as z: for p in sorted(UPLOAD.iterdir()): if p.is_file() and p!=zip_path:z.write(p,p.name) print('Final bundle:',zip_path) ''')) cells.append(md(''' ## Reading Notebook 77B The decisive output is `direct_A2_vs_C1_comparison.json`. - `VETOED_FROM_C1.PRINT = 0` and `VETOED_FROM_C1.ANNOTATION > 0` means A2 strictly dominates C1 on the authoritative Notebook 75 PRINT/ANNOTATION population. - Any vetoed PRINT row must be reviewed before preferring A2. - `UNCERTAIN` is kept separate rather than being counted as either benefit or harm. - The Notebook 75 pixel-table reproduction gate must pass before any A2 interpretation is permitted. - Notebook 77's expensive sensitivity table is not used here. This notebook evaluates only the already locked, predeclared A2 paper-veto policy. ''')) nb={'cells':cells,'metadata':{'colab':{'name':'77B_Direct_Notebook75_Pixel_Join_Audit.ipynb','provenance':[]},'kernelspec':{'display_name':'Python 3','language':'python','name':'python3'},'language_info':{'name':'python'}},'nbformat':4,'nbformat_minor':5}
