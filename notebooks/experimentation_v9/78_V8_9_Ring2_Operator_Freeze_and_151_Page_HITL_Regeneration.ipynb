      "source": [
        "# ============================================================\n",
        "# Gate 1: exact V8.8 parent equivalence\n",
        "# ============================================================\n",
        "\n",
        "NB72 = latest(\n",
        "    NB72_ROOT,\n",
        "    [\"inputs/runtime_roster.csv\"],\n",
        ")\n",
        "\n",
        "require(\n",
        "    NB72 is not None,\n",
        "    \"Complete Notebook 72 run not found.\",\n",
        ")\n",
        "\n",
        "roster = pd.read_csv(\n",
        "    NB72 / \"inputs/runtime_roster.csv\"\n",
        ")\n",
        "\n",
        "required = {\n",
        "    \"page\",\n",
        "    \"observed_path\",\n",
        "    \"seed_mask_path\",\n",
        "}\n",
        "\n",
        "require(\n",
        "    required <= set(roster.columns),\n",
        "    (\n",
        "        \"Notebook 72 runtime roster missing: \"\n",
        "        f\"{sorted(required - set(roster.columns))}\"\n",
        "    ),\n",
        ")\n",
        "\n",
        "rows = []\n",
        "\n",
        "for _, r in roster.iterrows():\n",
        "\n",
        "    page = str(r.page)\n",
        "\n",
        "    obs = cv2.imread(\n",
        "        str(r.observed_path),\n",
        "        cv2.IMREAD_GRAYSCALE,\n",
        "    )\n",
        "\n",
        "    seed = cv2.imread(\n",
        "        str(r.seed_mask_path),\n",
        "        cv2.IMREAD_GRAYSCALE,\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        obs is not None\n",
        "        and seed is not None\n",
        "        and obs.shape == seed.shape,\n",
        "        f\"{page}: input failure\",\n",
        "    )\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Run the V8.9 operator once.\n",
        "    #\n",
        "    # V89PageResult already contains the exact parent V8.8\n",
        "    # corrected page as parent_v88_corrected.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    child = op.run_page(\n",
        "        obs,\n",
        "        seed,\n",
        "        page=page,\n",
        "    )\n",
        "\n",
        "    ring2 = np.asarray(\n",
        "        child.ring2_mask,\n",
        "        dtype=bool,\n",
        "    )\n",
        "\n",
        "    delta = np.asarray(\n",
        "        child.v89_delta_mask,\n",
        "        dtype=bool,\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Core V8.9 parent-regression contract\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    non_ring2_mismatch = int(\n",
        "        np.sum(\n",
        "            child.corrected[~ring2]\n",
        "            != child.parent_v88_corrected[~ring2]\n",
        "        )\n",
        "    )\n",
        "\n",
        "    ring2_observed_mismatch = int(\n",
        "        np.sum(\n",
        "            child.corrected[ring2]\n",
        "            != child.observed[ring2]\n",
        "        )\n",
        "    )\n",
        "\n",
        "    unexpected_delta = int(\n",
        "        np.sum(\n",
        "            delta\n",
        "            & ~ring2\n",
        "        )\n",
        "    )\n",
        "\n",
        "    expected_effective_delta = (\n",
        "        ring2\n",
        "        & (\n",
        "            child.observed\n",
        "            != child.parent_v88_corrected\n",
        "        )\n",
        "    )\n",
        "\n",
        "    delta_identity_mismatch = int(\n",
        "        np.logical_xor(\n",
        "            delta,\n",
        "            expected_effective_delta,\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Internal V8.8 result sanity\n",
        "    #\n",
        "    # These arrays are produced by the parent implementation\n",
        "    # inside the V8.9 call. They do not need a second expensive\n",
        "    # inference call merely to prove that V8.9 retained them.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    finite_p_print = np.isfinite(\n",
        "        child.p_print\n",
        "    )\n",
        "\n",
        "    finite_p_remove = np.isfinite(\n",
        "        child.p_remove\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        child.p_print.shape == obs.shape,\n",
        "        f\"{page}: p_print shape mismatch\",\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        child.p_remove.shape == obs.shape,\n",
        "        f\"{page}: p_remove shape mismatch\",\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        child.m3_mask.shape == obs.shape,\n",
        "        f\"{page}: M3 shape mismatch\",\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        child.safe_remove_mask.shape == obs.shape,\n",
        "        f\"{page}: SAFE_REMOVE shape mismatch\",\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        child.m5_remove_mask.shape == obs.shape,\n",
        "        f\"{page}: M5 shape mismatch\",\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Fail closed\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    require(\n",
        "        non_ring2_mismatch == 0,\n",
        "        (\n",
        "            f\"{page}: V8.9 changed \"\n",
        "            f\"{non_ring2_mismatch} non-Ring-2 \"\n",
        "            \"V8.8 parent pixels.\"\n",
        "        ),\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        ring2_observed_mismatch == 0,\n",
        "        (\n",
        "            f\"{page}: V8.9 failed observed-byte \"\n",
        "            f\"preservation at \"\n",
        "            f\"{ring2_observed_mismatch} Ring-2 pixels.\"\n",
        "        ),\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        unexpected_delta == 0,\n",
        "        (\n",
        "            f\"{page}: V8.9 changed \"\n",
        "            f\"{unexpected_delta} pixels outside Ring 2.\"\n",
        "        ),\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        delta_identity_mismatch == 0,\n",
        "        (\n",
        "            f\"{page}: V8.9 effective-delta map \"\n",
        "            f\"mismatch at {delta_identity_mismatch} pixels.\"\n",
        "        ),\n",
        "    )\n",
        "\n",
        "\n",
        "    rows.append({\n",
        "        \"page\":\n",
        "            page,\n",
        "\n",
        "        \"ring2_pixels\":\n",
        "            int(ring2.sum()),\n",
        "\n",
        "        \"effective_delta_pixels\":\n",
        "            int(delta.sum()),\n",
        "\n",
        "        \"parent_non_ring2_mismatch\":\n",
        "            non_ring2_mismatch,\n",
        "\n",
        "        \"ring2_observed_mismatch\":\n",
        "            ring2_observed_mismatch,\n",
        "\n",
        "        \"unexpected_delta_outside_ring2\":\n",
        "            unexpected_delta,\n",
        "\n",
        "        \"delta_identity_mismatch\":\n",
        "            delta_identity_mismatch,\n",
        "\n",
        "        \"p_print_finite_pixels\":\n",
        "            int(finite_p_print.sum()),\n",
        "\n",
        "        \"p_print_nan_pixels\":\n",
        "            int(np.isnan(child.p_print).sum()),\n",
        "\n",
        "        \"p_remove_finite_pixels\":\n",
        "            int(finite_p_remove.sum()),\n",
        "\n",
        "        \"p_remove_nan_pixels\":\n",
        "            int(np.isnan(child.p_remove).sum()),\n",
        "    })\n",
        "\n",
        "    print(\n",
        "        f\"{page}: \"\n",
        "        f\"Ring2={int(ring2.sum()):,}, \"\n",
        "        f\"changed={int(delta.sum()):,}\"\n",
        "    )\n",
        "\n",
        "\n",
        "eq = pd.DataFrame(rows)\n",
        "\n",
        "eq.to_csv(\n",
        "    RUN / \"gates\" / \"v88_parent_equivalence.csv\",\n",
        "    index=False,\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Final Gate-1 assertion\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "equivalence_columns = [\n",
        "    \"parent_non_ring2_mismatch\",\n",
        "    \"ring2_observed_mismatch\",\n",
        "    \"unexpected_delta_outside_ring2\",\n",
        "    \"delta_identity_mismatch\",\n",
        "]\n",
        "\n",
        "require(\n",
        "    (\n",
        "        eq[equivalence_columns]\n",
        "        .to_numpy()\n",
        "        == 0\n",
        "    ).all(),\n",
        "    (\n",
        "        \"V8.8 parent-equivalence gate failed. \"\n",
        "        \"Inspect v88_parent_equivalence.csv.\"\n",
        "    ),\n",
        ")\n",
        "\n",
        "print()\n",
        "print(\"=\" * 72)\n",
        "print(\"PASS: V8.8 -> V8.9 PARENT EQUIVALENCE\")\n",
        "print(\"=\" * 72)\n",
        "\n",
        "print(\n",
        "    \"Pages:\",\n",
        "    len(eq),\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Ring-2 pixels:\",\n",
        "    f\"{int(eq.ring2_pixels.sum()):,}\",\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Effective V8.9 changed pixels:\",\n",
        "    f\"{int(eq.effective_delta_pixels.sum()):,}\",\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Non-Ring-2 V8.8 regressions:\",\n",
        "    int(eq.parent_non_ring2_mismatch.sum()),\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Ring-2 observed-byte mismatches:\",\n",
        "    int(eq.ring2_observed_mismatch.sum()),\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Unexpected changes outside Ring 2:\",\n",
        "    int(eq.unexpected_delta_outside_ring2.sum()),\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Delta-map identity mismatches:\",\n",
        "    int(eq.delta_identity_mismatch.sum()),\n",
        ")"
      ]
    },
