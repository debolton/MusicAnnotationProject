      "source": [
        "# ============================================================\n",
        "# Gate 2: Notebook 75 C1 SEMANTIC reproduction\n",
        "#\n",
        "# IMPORTANT:\n",
        "# Notebook 75's rendered C1 pages used the historical Notebook72\n",
        "# incumbent output, which was subsequently superseded by the\n",
        "# corrected V8.8 assembly.\n",
        "#\n",
        "# Therefore V8.9 is NOT required to reproduce Notebook75's\n",
        "# complete C1 page bytes.\n",
        "#\n",
        "# What must reproduce exactly is the C1 transformation:\n",
        "#\n",
        "#     Ring2      -> exact observed byte\n",
        "#     not Ring2  -> exact current incumbent byte\n",
        "#\n",
        "# Here the current incumbent is the corrected V8.8 parent.\n",
        "# ============================================================\n",
        "\n",
        "rows = []\n",
        "\n",
        "for _, r in roster.iterrows():\n",
        "\n",
        "    page = str(r.page)\n",
        "\n",
        "    obs = cv2.imread(\n",
        "        str(r.observed_path),\n",
        "        cv2.IMREAD_GRAYSCALE,\n",
        "    )\n",
        "\n",
        "    seed = cv2.imread(\n",
        "        str(r.seed_path),\n",
        "        cv2.IMREAD_GRAYSCALE,\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        obs is not None\n",
        "        and seed is not None\n",
        "        and obs.shape == seed.shape,\n",
        "        f\"{page}: input failure\",\n",
        "    )\n",
        "\n",
        "    result = op.run_page(\n",
        "        obs,\n",
        "        seed,\n",
        "        page=page,\n",
        "    )\n",
        "\n",
        "    ring2 = np.asarray(\n",
        "        result.ring2_mask,\n",
        "        dtype=bool,\n",
        "    )\n",
        "\n",
        "    parent = np.asarray(\n",
        "        result.parent_v88_corrected,\n",
        "    )\n",
        "\n",
        "    child = np.asarray(\n",
        "        result.corrected,\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Independently rebuild Notebook75 C1 geometry.\n",
        "    #\n",
        "    # Ring1 = dilation1(seed) - seed\n",
        "    # Ring2 = dilation2(seed) - dilation1(seed)\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    seed_bool = seed > 0\n",
        "\n",
        "    k1 = cv2.getStructuringElement(\n",
        "        cv2.MORPH_ELLIPSE,\n",
        "        (3, 3),\n",
        "    )\n",
        "\n",
        "    k2 = cv2.getStructuringElement(\n",
        "        cv2.MORPH_ELLIPSE,\n",
        "        (5, 5),\n",
        "    )\n",
        "\n",
        "    d1 = (\n",
        "        cv2.dilate(\n",
        "            seed_bool.astype(np.uint8),\n",
        "            k1,\n",
        "        ) > 0\n",
        "    )\n",
        "\n",
        "    d2 = (\n",
        "        cv2.dilate(\n",
        "            seed_bool.astype(np.uint8),\n",
        "            k2,\n",
        "        ) > 0\n",
        "    )\n",
        "\n",
        "    expected_ring2 = d2 & ~d1\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Exact Notebook75 C1 transformation, but applied to the\n",
        "    # corrected V8.8 parent.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    expected_c1 = parent.copy()\n",
        "\n",
        "    expected_c1[\n",
        "        expected_ring2\n",
        "    ] = obs[\n",
        "        expected_ring2\n",
        "    ]\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Equivalence checks\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    ring2_xor = int(\n",
        "        np.logical_xor(\n",
        "            ring2,\n",
        "            expected_ring2,\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "    output_diff = int(\n",
        "        np.sum(\n",
        "            child != expected_c1\n",
        "        )\n",
        "    )\n",
        "\n",
        "    ring2_observed_mismatch = int(\n",
        "        np.sum(\n",
        "            child[expected_ring2]\n",
        "            != obs[expected_ring2]\n",
        "        )\n",
        "    )\n",
        "\n",
        "    non_ring2_parent_mismatch = int(\n",
        "        np.sum(\n",
        "            child[~expected_ring2]\n",
        "            != parent[~expected_ring2]\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    require(\n",
        "        ring2_xor == 0,\n",
        "        (\n",
        "            f\"{page}: V8.9 Ring2 differs from \"\n",
        "            f\"Notebook75 C1 geometry at \"\n",
        "            f\"{ring2_xor} pixels.\"\n",
        "        ),\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        output_diff == 0,\n",
        "        (\n",
        "            f\"{page}: V8.9 does not reproduce \"\n",
        "            f\"the Notebook75 C1 transformation \"\n",
        "            f\"on the corrected V8.8 parent. \"\n",
        "            f\"Different pixels: {output_diff}\"\n",
        "        ),\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        ring2_observed_mismatch == 0,\n",
        "        (\n",
        "            f\"{page}: Ring2 does not contain \"\n",
        "            \"exact observed bytes.\"\n",
        "        ),\n",
        "    )\n",
        "\n",
        "    require(\n",
        "        non_ring2_parent_mismatch == 0,\n",
        "        (\n",
        "            f\"{page}: non-Ring2 regression \"\n",
        "            \"from corrected V8.8 parent.\"\n",
        "        ),\n",
        "    )\n",
        "\n",
        "\n",
        "    rows.append({\n",
        "        \"page\":\n",
        "            page,\n",
        "\n",
        "        \"ring2_pixels\":\n",
        "            int(expected_ring2.sum()),\n",
        "\n",
