      "source": [
        "# PROVENANCE: consolidated project integrity helpers from the V7.8/Notebook 09 lineage.\n",
        "def require(condition,message):\n",
        "    if not bool(condition):\n",
        "        try:\n",
        "            (AUDIT/'fatal_failure.json').write_text(json.dumps({'utc':datetime.now(timezone.utc).isoformat(),'message':str(message)},indent=2))\n",
        "        except Exception:\n",
        "            pass\n",
        "        raise RuntimeError(message)\n",
        "\n",
        "def md5_file(path):\n",
        "    h=hashlib.md5()\n",
        "    with open(path,'rb') as f:\n",
        "        for block in iter(lambda:f.read(1048576),b''): h.update(block)\n",
        "    return h.hexdigest()\n",
        "\n",
        "def sha256_file(path):\n",
        "    path=Path(path); require(path.exists() and path.is_file(),f'Missing file: {path}')\n",
        "    h=hashlib.sha256()\n",
        "    with open(path,'rb') as f:\n",
        "        for block in iter(lambda:f.read(1048576),b''): h.update(block)\n",
        "    return h.hexdigest()\n",
        "\n",
        "def array_hash(a):\n",
        "    a=np.ascontiguousarray(a); h=hashlib.sha256(); h.update(str(a.dtype).encode()); h.update(str(a.shape).encode()); h.update(a.tobytes()); return h.hexdigest()\n",
        "\n",
        "def object_hash(value):\n",
        "    return hashlib.sha256(json.dumps(value,sort_keys=True,default=str,separators=(',',':')).encode()).hexdigest()\n",
        "\n",
        "def atomic_json(path,value):\n",
        "    path=Path(path); tmp=Path(str(path)+'.tmp'); tmp.write_text(json.dumps(value,indent=2,sort_keys=True,default=str)); tmp.replace(path)\n",
        "\n",
        "def read_gray(path):\n",
        "    im=cv2.imread(str(path),cv2.IMREAD_GRAYSCALE); require(im is not None,f'Unreadable image: {path}'); return im\n",
        "\n",
        "def binary(mask):\n",
        "    return np.where(mask>0,255,0).astype(np.uint8)\n",
        "\n",
        "def normalised_path_string(value):\n",
        "    if value is None or not str(value).strip(): return None\n",
        "    return str(value).strip().replace('\\\\','/').rstrip('/').casefold()"
      ],
      "id": "SA8Wl2sJXVFH"
    },
