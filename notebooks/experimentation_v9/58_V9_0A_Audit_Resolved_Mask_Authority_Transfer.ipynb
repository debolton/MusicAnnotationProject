    "## 13. Final Upload Package"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PROVENANCE: standard project Final Upload Package requirement.\n",
    "# Curated review package only. Heavy working artefacts remain in\n",
    "# the run directory and are referenced through the audit records.\n",
    "\n",
    "required = [\n",
    "    OUT / 'v9_0a_verdict.json',\n",
    "\n",
    "    AUDIT / 'notebook06_draft_audit_inventory.csv',\n",
    "    AUDIT / 'notebook07_to_notebook06_resolution_attempts.csv',\n",
    "    AUDIT / 'unresolved_review_lineages.csv',\n",
    "    AUDIT / 'hitl_input_resolution.csv',\n",
    "    AUDIT / 'hitl_resolution_summary.json',\n",
    "    AUDIT / 'yolo_gate_identity.json',\n",
    "\n",
    "    LOCKS / 'mask_arm_manifest.csv',\n",
    "    LOCKS / 'corrected_output_manifest.csv',\n",
    "    LOCKS / 'prediction_and_output_lock.json',\n",
    "\n",
    "    SCORE / 'reviewer_edits.csv',\n",
    "    SCORE / 'paired_mask_and_output_evidence.csv',\n",
    "    SCORE / 'arm_summary.csv',\n",
    "    SCORE / 'visual_audit_queue.csv',\n",
    "]\n",
    "\n",
    "# Optional post-lock clean-truth evidence.\n",
    "truth_path = SCORE / 'postlock_clean_truth_scores.csv'\n",
    "\n",
    "if truth_path.exists():\n",
    "    required.append(truth_path)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Fail closed if any required review artefact is absent\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "for path in required:\n",
    "    require(\n",
    "        path.exists(),\n",
    "        f'Missing upload artefact: {path}'\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# README\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "readme = (\n",
    "    'V9.0A audit-resolved mask-authority transfer experiment.\\n'\n",
    "    '\\n'\n",
    "    'Notebook 07 review audits define the canonical PageXXX roster.\\n'\n",
    "    'Notebook 06 draft evidence is resolved backwards using audited '\n",
    "    'path and content identity.\\n'\n",
    "    'Ambiguous or unresolved lineages are reported rather than guessed.\\n'\n",
    "    '\\n'\n",
    "    'Research evidence only.\\n'\n",
    "    'No automatic mask authority or production output is authorised.\\n'\n",
    ")\n",
    "\n",
    "(UPLOAD / 'README.txt').write_text(readme)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Remove stale package-control artefacts from a previous\n",
    "# execution of this cell.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "zip_path = UPLOAD / '58_V9_0A_upload_bundle.zip'\n",
    "\n",
    "if zip_path.exists():\n",
    "    zip_path.unlink()\n",
    "\n",
    "for stale in [\n",
    "    UPLOAD / 'upload_manifest.csv',\n",
    "    UPLOAD / 'upload_file_list.txt',\n",
    "]:\n",
    "    if stale.exists():\n",
    "        stale.unlink()\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Copy curated artefacts\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "rows = []\n",
    "\n",
    "visuals = sorted(\n",
    "    VISUAL.glob('*.png')\n",
    ")[:30]\n",
    "\n",
    "for src in required + visuals:\n",
    "\n",
    "    require(\n",
    "        src.exists(),\n",
    "        f'Upload source disappeared before packaging: {src}'\n",
    "    )\n",
    "\n",
    "    if src.suffix.lower() == '.png':\n",
    "        category = 'visuals'\n",
    "\n",
    "    elif src.parent == SCORE:\n",
    "        category = 'tables'\n",
    "\n",
    "    elif src.parent in [AUDIT, LOCKS\\]:\n",
    "        category = 'audit'\n",
    "\n",
    "    else:\n",
    "        category = 'root'\n",
    "\n",
    "    dst = UPLOAD / category / src.name\n",
    "\n",
    "    dst.parent.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True,\n",
    "    )\n",
    "\n",
    "    shutil.copy2(\n",
    "        src,\n",
    "        dst,\n",
    "    )\n",
    "\n",
    "    rows.append({\n",
    "        'relative_path':\n",
    "            str(dst.relative_to(UPLOAD)),\n",
    "\n",
    "        'bytes':\n",
    "            dst.stat().st_size,\n",
    "\n",
    "        'sha256':\n",
    "            sha256_file(dst),\n",
    "    })\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Write package manifests\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "upload_manifest = (\n",
    "    pd.DataFrame(rows)\n",
    "    .sort_values('relative_path')\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "require(\n",
    "    len(upload_manifest) == len(rows),\n",
    "    'Upload manifest row-count mismatch.'\n",
    ")\n",
    "\n",
    "require(\n",
    "    not upload_manifest['relative_path'].duplicated().any(),\n",
    "    'Duplicate relative paths in upload package.'\n",
    ")\n",
    "\n",
    "upload_manifest.to_csv(\n",
    "    UPLOAD / 'upload_manifest.csv',\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "(UPLOAD / 'upload_file_list.txt').write_text(\n",
    "    '\\n'.join(\n",
    "        upload_manifest['relative_path']\n",
    "    )\n",
    "    + '\\n'\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Create ZIP\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "with zipfile.ZipFile(\n",
    "    zip_path,\n",
    "    'w',\n",
    "    zipfile.ZIP_DEFLATED,\n",
    ") as archive:\n",
    "\n",
    "    for p in sorted(UPLOAD.rglob('*')):\n",
    "\n",
    "        if not p.is_file():\n",
    "            continue\n",
    "\n",
    "        if p == zip_path:\n",
    "            continue\n",
    "\n",
    "        archive.write(\n",
    "            p,\n",
    "            p.relative_to(UPLOAD),\n",
    "        )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Final integrity checks\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "require(\n",
    "    zip_path.exists(),\n",
    "    'Upload bundle creation failed.'\n",
    ")\n",
    "\n",
    "require(\n",
    "    zip_path.stat().st_size > 0,\n",
    "    'Upload bundle is empty.'\n",
    ")\n",
    "\n",
    "require(\n",
    "    (UPLOAD / 'upload_manifest.csv').exists(),\n",
    "    'Upload manifest missing after package creation.'\n",
    ")\n",
    "\n",
    "require(\n",
    "    (UPLOAD / 'upload_file_list.txt').exists(),\n",
    "    'Upload file list missing after package creation.'\n",
    ")\n",
    "\n",
    "require(\n",
    "    (UPLOAD / 'README.txt').exists(),\n",
    "    'Upload README missing after package creation.'\n",
    ")\n",
    "\n",
    "\n",
    "# Verify every packaged source still matches its recorded hash.\n",
    "for _, row in upload_manifest.iterrows():\n",
    "\n",
    "    packaged = (\n",
    "        UPLOAD\n",
    "        / row['relative_path']\n",
    "    )\n",
    "\n",
    "    require(\n",
    "        packaged.exists(),\n",
    "        f'Packaged file missing: {packaged}'\n",
    "    )\n",
    "\n",
    "    require(\n",
    "        sha256_file(packaged) == row['sha256'],\n",
    "        f'Packaged file hash mismatch: {packaged}'\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    'Upload bundle:',\n",
    "    zip_path,\n",
    ")\n",
    "\n",
    "print(\n",
    "    'Packaged review artefacts:',\n",
    "    len(upload_manifest),\n",
    ")\n",
    "\n",
    "print(\n",
    "    'Bundle bytes:',\n",
    "    zip_path.stat().st_size,\n",
    ")"
   ]
