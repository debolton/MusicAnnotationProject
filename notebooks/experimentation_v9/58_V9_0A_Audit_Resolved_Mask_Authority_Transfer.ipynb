    "# PROVENANCE: adapted from Notebook 09 read_audit_records.\n",
    "def load_audit_records(folder,audit_type):\n",
    "    records=[]; failures=[]\n",
    "    for audit_path in sorted(Path(folder).glob('*.json')):\n",
    "        try:\n",
    "            record=json.loads(audit_path.read_text())\n",
    "            if not isinstance(record,dict): raise ValueError('Audit root must be a JSON object.')\n",
    "            record['_audit_path']=str(audit_path)\n",
    "            record['_audit_name']=audit_path.name\n",
    "            record['_audit_stem']=audit_path.stem\n",
    "            record['_audit_type']=audit_type\n",
    "            record['_audit_mtime_ns']=audit_path.stat().st_mtime_ns\n",
    "            records.append(record)\n",
    "        except Exception as error:\n",
    "            failures.append({'audit_type':audit_type,'audit_path':str(audit_path),'error':str(error)})\n",
    "    return records,failures\n",
    "\n",
    "def recorded_path(record,possible_fields):\n",
    "    for field in possible_fields:\n",
    "        value=record.get(field)\n",
    "        if value is not None and str(value).strip(): return Path(str(value)),field\n",
    "    return None,None\n",
    "\n",
    "def required_existing_path(record,possible_fields,audit_type):\n",
    "    attempted=[]\n",
    "    for field in possible_fields:\n",
    "        value=record.get(field)\n",
    "        if value is None or not str(value).strip(): continue\n",
    "        path=Path(str(value)); attempted.append({'field':field,'path':str(path),'exists':path.exists()})\n",
    "        if path.exists(): return path,field\n",
    "    raise RuntimeError(f'{audit_type} audit has no existing file for fields {possible_fields}: {record.get(\"_audit_path\")}. Attempted: {attempted}')\n",
    "\n",
    "def audit_source_path(record,audit_type):\n",
    "    fields=['source_file','source','input_file','input_path'] if audit_type=='draft' else ['source','source_file','original_source','input_file','input_path']\n",
    "    return recorded_path(record,fields)\n",
    "\n",
    "def safe_recorded_md5(record):\n",
    "    value=record.get('source_md5')\n",
    "    if value is None:return None\n",
    "    value=str(value).strip().lower()\n",
    "    return value or None\n",
    "\n",
    "def stable_draft_signature(record):\n",
    "    fields=['source_file','source_md5','draft_mask','confidence_map','model_path','model_md5','prediction_confidence','shape']\n",
    "    return object_hash({field:record.get(field) for field in fields})\n",
    "\n",
    "def collapse_identical_drafts(records,context):\n",
    "    unique={r['_audit_path']:r for r in records}; records=list(unique.values())\n",
    "    if len(records)==1:return records[0],'unique',1\n",
    "    groups={}\n",
    "    for record in records: groups.setdefault(stable_draft_signature(record),[]).append(record)\n",
    "    if len(groups)!=1:\n",
    "        raise RuntimeError(f'{context}: conflicting Notebook 06 draft audits: {[r[\"_audit_path\"] for r in records]}')\n",
    "    replicas=next(iter(groups.values()))\n",
    "    return sorted(replicas,key=lambda r:r['_audit_path'])[0],'identical_replicas_collapsed',len(replicas)\n",
    "\n",
    "DRAFT_AUDITS,draft_failures=load_audit_records(DRAFT_AUDIT_DIR,'draft')\n",
    "REVIEW_AUDITS,review_failures=load_audit_records(REVIEW_AUDIT_DIR,'review')\n",
    "failures=draft_failures+review_failures\n",
    "if failures:\n",
    "    pd.DataFrame(failures).to_csv(AUDIT/'audit_parse_failures.csv',index=False)\n",
    "    raise RuntimeError(f'{len(failures)} HITL audit records could not be read.')\n",
    "require(DRAFT_AUDITS,f'No Notebook 06 draft audits found in {DRAFT_AUDIT_DIR}')\n",
    "require(REVIEW_AUDITS,f'No Notebook 07 review audits found in {REVIEW_AUDIT_DIR}')\n",
    "print('Notebook 06 draft audits:',len(DRAFT_AUDITS))\n",
    "print('Notebook 07 review audits:',len(REVIEW_AUDITS))"
   ]
