        "id": "bjmrZoQtXVFI"
      },
      "source": [
        "## 4. Resolve Notebook 07 PageXXX records backwards to Notebook 06 artefacts"
      ],
      "id": "bjmrZoQtXVFI"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "gCqLzTfjXVFI"
      },
      "outputs": [],
      "source": [
        "# PROVENANCE: NEW V9.0A resolver using Notebook 09 audit fields.\n",
        "# This is the sole resolver. There is no whole-directory `paired` source_md5 intersection.\n",
        "drafts_by_recorded_path={}; drafts_by_actual_md5={}; drafts_by_stored_md5={}; drafts_by_source_name={}; draft_inventory=[]\n",
        "for draft in DRAFT_AUDITS:\n",
        "    source_path,source_field=audit_source_path(draft,'draft')\n",
        "    path_key=normalised_path_string(source_path)\n",
        "    actual_md5=md5_file(source_path).lower() if source_path is not None and source_path.exists() else None\n",
        "    stored_md5=safe_recorded_md5(draft)\n",
        "    source_name=source_path.name.casefold() if source_path is not None else None\n",
        "    if path_key:drafts_by_recorded_path.setdefault(path_key,[]).append(draft)\n",
        "    if actual_md5:drafts_by_actual_md5.setdefault(actual_md5,[]).append(draft)\n",
        "    if stored_md5:drafts_by_stored_md5.setdefault(stored_md5,[]).append(draft)\n",
        "    if source_name:drafts_by_source_name.setdefault(source_name,[]).append(draft)\n",
        "    draft_inventory.append({'draft_audit_path':draft['_audit_path'],'recorded_source_field':source_field,'recorded_source_path':str(source_path) if source_path else None,'recorded_source_exists':bool(source_path and source_path.exists()),'actual_source_md5':actual_md5,'stored_source_md5':stored_md5,'source_filename':source_path.name if source_path else None,'draft_mask':draft.get('draft_mask'),'confidence_map':draft.get('confidence_map'),'model_path':draft.get('model_path'),'model_md5':draft.get('model_md5'),'prediction_confidence':draft.get('prediction_confidence')})\n",
        "pd.DataFrame(draft_inventory).to_csv(AUDIT/'notebook06_draft_audit_inventory.csv',index=False)\n",
        "\n",
        "resolved_rows=[]; attempt_rows=[]; unresolved_rows=[]\n",
        "for review in REVIEW_AUDITS:\n",
        "    page=str(review.get('page','')).strip() or Path(review['_audit_path']).stem\n",
        "    if not re.fullmatch(r'Page\\d+',page,flags=re.IGNORECASE):\n",
        "        unresolved_rows.append({'page':page,'review_audit_path':review['_audit_path'],'reason':'invalid_notebook07_page_identity'}); continue\n",
        "    review_source_path,review_source_field=audit_source_path(review,'review')\n",
        "    review_path_key=normalised_path_string(review_source_path)\n",
        "    review_stored_md5=safe_recorded_md5(review)\n",
        "    review_actual_md5=md5_file(review_source_path).lower() if review_source_path is not None and review_source_path.exists() else None\n",
        "    review_source_name=review_source_path.name.casefold() if review_source_path is not None else None\n",
        "    candidate_sets=[]\n",
        "    def add_candidates(method,strength,candidates):\n",
        "        if candidates:candidate_sets.append({'method':method,'strength':strength,'candidates':candidates})\n",
        "    add_candidates('exact_recorded_source_path',1,drafts_by_recorded_path.get(review_path_key,[]) if review_path_key else [])\n",
        "    add_candidates('actual_source_file_md5',2,drafts_by_actual_md5.get(review_actual_md5,[]) if review_actual_md5 else [])\n",
        "    add_candidates('review_actual_md5_to_draft_stored_md5',3,drafts_by_stored_md5.get(review_actual_md5,[]) if review_actual_md5 else [])\n",
        "    add_candidates('review_stored_md5_to_draft_actual_md5',4,drafts_by_actual_md5.get(review_stored_md5,[]) if review_stored_md5 else [])\n",
        "    add_candidates('stored_source_md5',5,drafts_by_stored_md5.get(review_stored_md5,[]) if review_stored_md5 else [])\n",
        "    add_candidates('unique_original_source_filename',6,drafts_by_source_name.get(review_source_name,[]) if review_source_name else [])\n",
        "    for cs in candidate_sets:\n",
        "        for candidate in cs['candidates']:\n",
        "            attempt_rows.append({'page':page,'review_audit_path':review['_audit_path'],'review_source_field':review_source_field,'review_source_path':str(review_source_path) if review_source_path else None,'review_source_exists':bool(review_source_path and review_source_path.exists()),'review_actual_md5':review_actual_md5,'review_stored_md5':review_stored_md5,'resolution_method':cs['method'],'resolution_strength':cs['strength'],'draft_audit_candidate':candidate['_audit_path']})\n",
        "    if not candidate_sets:\n",
        "        unresolved_rows.append({'page':page,'review_audit_path':review['_audit_path'],'review_source_path':str(review_source_path) if review_source_path else None,'review_actual_md5':review_actual_md5,'review_stored_md5':review_stored_md5,'reason':'no_notebook06_candidate_found'}); continue\n",
        "    chosen=None; chosen_method=None; replica_status=None; replica_count=None; errors=[]\n",
        "    for cs in sorted(candidate_sets,key=lambda x:x['strength']):\n",
        "        try:\n",
        "            chosen,replica_status,replica_count=collapse_identical_drafts(cs['candidates'],f'{page} via {cs[\"method\"]}')\n",
        "            chosen_method=cs['method']; break\n",
        "        except RuntimeError as error:\n",
        "            errors.append({'method':cs['method'],'error':str(error)})\n",
        "    if chosen is None:\n",
        "        unresolved_rows.append({'page':page,'review_audit_path':review['_audit_path'],'reason':'all_candidate_methods_ambiguous','details':json.dumps(errors,sort_keys=True)}); continue\n",
        "    try:\n",
        "        observed_path,observed_field=required_existing_path(review,['aligned_output','aligned_page','observed_output'],'Notebook 07 review')\n",
        "        reviewed_mask_path,reviewed_mask_field=required_existing_path(review,['corrected_mask_output','corrected_mask','mask_output'],'Notebook 07 review')\n",
        "        raw_mask_path,raw_mask_field=required_existing_path(chosen,['draft_mask','draft_mask_path'],'Notebook 06 draft')\n",
        "        confidence_path,confidence_field=required_existing_path(chosen,['confidence_map','confidence_map_path'],'Notebook 06 draft')\n",
        "        draft_source_path,draft_source_field=required_existing_path(chosen,['source_file','source','input_file','input_path'],'Notebook 06 draft')\n",
        "        observed=read_gray(observed_path); raw=read_gray(raw_mask_path); reviewed=read_gray(reviewed_mask_path); confidence=np.load(confidence_path).astype(np.float32)\n",
        "        require(observed.shape==raw.shape==reviewed.shape==confidence.shape,f'{page}: shape mismatch observed={observed.shape}, raw={raw.shape}, reviewed={reviewed.shape}, confidence={confidence.shape}')\n",
        "        require(np.isfinite(confidence).all(),f'{page}: confidence map contains non-finite values')\n",
        "        draft_actual_md5=md5_file(draft_source_path).lower(); draft_stored_md5=safe_recorded_md5(chosen)\n",
        "        if draft_stored_md5 is not None:require(draft_actual_md5==draft_stored_md5,f'{page}: selected Notebook 06 audit has stale source_md5')\n",
        "        if review_actual_md5 is not None:require(draft_actual_md5==review_actual_md5,f'{page}: selected Notebook 06 and Notebook 07 original sources differ')\n",
        "        resolved_rows.append({'page':page,'source_md5':draft_actual_md5,'original_source_path':str(draft_source_path),'observed_path':str(observed_path),'raw_yolo_mask_path':str(raw_mask_path),'confidence_map_path':str(confidence_path),'reviewed_mask_path':str(reviewed_mask_path),'draft_audit_path':chosen['_audit_path'],'review_audit_path':review['_audit_path'],'resolution_method':chosen_method,'draft_replica_status':replica_status,'draft_replica_count':replica_count,'draft_model_path':chosen.get('model_path'),'draft_model_md5':chosen.get('model_md5'),'draft_prediction_confidence':chosen.get('prediction_confidence')})\n",
        "    except Exception as error:\n",
        "        unresolved_rows.append({'page':page,'review_audit_path':review['_audit_path'],'draft_audit_path':chosen['_audit_path'],'resolution_method':chosen_method,'reason':'resolved_candidate_failed_validation','details':str(error)})\n",
        "\n",
        "pd.DataFrame(attempt_rows).to_csv(AUDIT/'notebook07_to_notebook06_resolution_attempts.csv',index=False)\n",
        "unresolved=pd.DataFrame(unresolved_rows,columns=['page','review_audit_path','draft_audit_path','review_source_path','review_actual_md5','review_stored_md5','resolution_method','reason','details'])\n",
        "unresolved.to_csv(AUDIT/'unresolved_review_lineages.csv',index=False)\n",
        "resolution=pd.DataFrame(resolved_rows)\n",
        "require(not resolution.empty,f'No Notebook 07 reviewed pages resolved to valid Notebook 06 artefacts. Inspect {AUDIT}.')\n",
        "require('page' in resolution.columns,f'Resolution table has no page column. Columns={resolution.columns.tolist()}')\n",
        "require(not resolution.page.duplicated().any(),'Duplicate canonical PageXXX identities remain after resolution.')\n",
        "require(not resolution.source_md5.duplicated().any(),'More than one PageXXX resolves to the same original Notebook 06 source.')\n",
        "if PAGE_ALLOWLIST is not None:\n",
