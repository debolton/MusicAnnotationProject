    "\n",
    "pd.DataFrame(attempt_rows).to_csv(AUDIT/'notebook07_to_notebook06_resolution_attempts.csv',index=False)\n",
    "unresolved=pd.DataFrame(unresolved_rows,columns=['page','review_audit_path','draft_audit_path','review_source_path','review_actual_md5','review_stored_md5','resolution_method','reason','details'])\n",
    "unresolved.to_csv(AUDIT/'unresolved_review_lineages.csv',index=False)\n",
    "resolution=pd.DataFrame(resolved_rows)\n",
    "require(not resolution.empty,f'No Notebook 07 reviewed pages resolved to valid Notebook 06 artefacts. Inspect {AUDIT}.')\n",
    "require('page' in resolution.columns,f'Resolution table has no page column. Columns={resolution.columns.tolist()}')\n",
    "require(not resolution.page.duplicated().any(),'Duplicate canonical PageXXX identities remain after resolution.')\n",
    "require(not resolution.source_md5.duplicated().any(),'More than one PageXXX resolves to the same original Notebook 06 source.')\n",
    "if PAGE_ALLOWLIST is not None:\n",
    "    requested=set(map(str,PAGE_ALLOWLIST)); missing=sorted(requested-set(resolution.page.astype(str))); require(not missing,f'Allowlisted pages lack complete lineage: {missing}'); resolution=resolution[resolution.page.astype(str).isin(requested)].copy()\n",
    "resolution=resolution.sort_values('page').reset_index(drop=True)\n",
    "if UNRESOLVED_LINEAGE_POLICY=='require_complete':require(len(unresolved)==0,f'{len(unresolved)} review records are unresolved.')\n",
    "require(UNRESOLVED_LINEAGE_POLICY in {'exclude_and_report','require_complete'},'Unsupported unresolved-lineage policy.')\n",
    "resolution.to_csv(AUDIT/'hitl_input_resolution.csv',index=False)\n",
    "summary={'created_utc':datetime.now(timezone.utc).isoformat(),'notebook06_draft_audits':len(DRAFT_AUDITS),'notebook07_review_audits':len(REVIEW_AUDITS),'resolved_pages':len(resolution),'unresolved_review_records':len(unresolved),'unresolved_lineage_policy':UNRESOLVED_LINEAGE_POLICY,'resolution_methods':resolution.resolution_method.value_counts().sort_index().to_dict(),'canonical_page_identity':'Notebook 07 page / PageXXX','cross_stage_filename_stem_join':False,'whole_directory_md5_intersection_required':False}\n",
    "atomic_json(AUDIT/'hitl_resolution_summary.json',summary)\n",
    "EXPECTED=['page','source_md5','resolution_method','draft_replica_status','draft_replica_count','raw_yolo_mask_path','confidence_map_path','reviewed_mask_path','draft_audit_path','review_audit_path']\n",
    "missing=[x for x in EXPECTED if x not in resolution.columns]; require(not missing,f'Resolution table missing {missing}. Actual={resolution.columns.tolist()}')\n",
    "print(json.dumps(summary,indent=2)); display(resolution[EXPECTED])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Validate detector-confidence mask gate"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PROVENANCE: V9.0A control. Notebook 06 raw generation threshold and the inherited gate remain distinct.\n",
    "require(ESTABLISHED_YOLO_GATE is not None,'Set the established Notebook 06 detector-confidence gate.')\n",
    "require(ESTABLISHED_YOLO_GATE_POLICY_ID and str(ESTABLISHED_YOLO_GATE_POLICY_ID).strip(),'Set the gate experiment/policy identity.')\n",
    "ESTABLISHED_YOLO_GATE=float(ESTABLISHED_YOLO_GATE)\n",
    "require(0.0<=ESTABLISHED_YOLO_GATE<=1.0,'Gate must be in [0,1].')\n",
    "raw_values=pd.to_numeric(resolution.draft_prediction_confidence,errors='coerce').dropna().unique().tolist()\n",
    "require(len(raw_values)<=1,f'Notebook 06 audits disagree on prediction_confidence: {raw_values}')\n",
    "raw_threshold=float(raw_values[0]) if raw_values else None\n",
    "require(raw_threshold is None or ESTABLISHED_YOLO_GATE>raw_threshold,'Gate must exceed the raw Notebook 06 draft threshold.')\n",
    "gate_record={'gate':ESTABLISHED_YOLO_GATE,'policy_id':str(ESTABLISHED_YOLO_GATE_POLICY_ID),'raw_notebook06_prediction_confidence':raw_threshold,'optimised_in_v9_0a':False,'v8_2_observed_print_policy_used':False}\n",
    "atomic_json(AUDIT/'yolo_gate_identity.json',gate_record)\n",
    "print(json.dumps(gate_record,indent=2))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Canonical correction functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PROVENANCE: TRANSPLANTED from the canonical V7.8 block used by Notebook 09.\n",
    "def immutable(original,candidate,mask):\n",
    "    out=original.copy(); out[mask>0]=candidate[mask>0]; require(np.array_equal(out[mask==0],original[mask==0]),'Outside-mask drift'); return out\n",
    "\n",
    "def prepare_mask(seed,dilation=MASK_DILATION):\n",
    "    mask=binary(seed)\n",
    "    if dilation>0: mask=cv2.dilate(mask,cv2.getStructuringElement(cv2.MORPH_ELLIPSE,(2*dilation+1,2*dilation+1)))\n",
    "    return mask\n",
    "\n",
    "def padded_components(mask):\n",
    "    n,lab,stats,_=cv2.connectedComponentsWithStats((mask>0).astype(np.uint8),8); h,w=mask.shape; boxes=[]\n",
    "    for i in range(1,n):\n",
    "        x,y,bw,bh,area=stats[i]\n",
    "        if area>=8: boxes.append((max(0,x-CROP_MARGIN),max(0,y-CROP_MARGIN),min(w,x+bw+CROP_MARGIN),min(h,y+bh+CROP_MARGIN)))\n",
    "    changed=True\n",
    "    while changed:\n",
    "        changed=False; merged=[]\n",
    "        while boxes:\n",
    "            ax0,ay0,ax1,ay1=boxes.pop(); rest=[]\n",
    "            for bx0,by0,bx1,by1 in boxes:\n",
    "                if not (ax1<bx0 or bx1<ax0 or ay1<by0 or by1<ay0): ax0=min(ax0,bx0);ay0=min(ay0,by0);ax1=max(ax1,bx1);ay1=max(ay1,by1);changed=True\n",
    "                else: rest.append((bx0,by0,bx1,by1))\n",
    "            boxes=rest; merged.append((ax0,ay0,ax1,ay1))\n",
    "        boxes=merged\n",
    "    return boxes\n",
    "\n",
    "def telea_reconstruct(observed,mask):\n",
    "    result=observed.copy()\n",
    "    for x0,y0,x1,y1 in padded_components(mask):\n",
    "        im=observed[y0:y1,x0:x1]; mk=mask[y0:y1,x0:x1]; cand=cv2.inpaint(im,mk,3,cv2.INPAINT_TELEA); local=result[y0:y1,x0:x1]; local[mk>0]=cand[mk>0]\n",
    "    return immutable(observed,result,mask)\n",
    "\n",
    "def background_surface(observed,mask,sigma=45.0):\n",
    "    visible=(mask==0)&(observed>=200); values=observed.astype(np.float32)*visible; weights=visible.astype(np.float32); num=cv2.GaussianBlur(values,(0,0),sigma); den=cv2.GaussianBlur(weights,(0,0),sigma); fallback=cv2.GaussianBlur(observed,(0,0),sigma); return np.clip(np.where(den>0.02,num/np.maximum(den,1e-4),fallback),0,255).astype(np.uint8)\n",
    "\n",
    "def support_maps(observed,mask):\n",
    "    dark=(observed<190)&(mask==0); h=cv2.morphologyEx(dark.astype(np.uint8)*255,cv2.MORPH_OPEN,np.ones((1,35),np.uint8))>0; v=cv2.morphologyEx(dark.astype(np.uint8)*255,cv2.MORPH_OPEN,np.ones((15,1),np.uint8))>0; n,lab,stats,_=cv2.connectedComponentsWithStats(dark.astype(np.uint8),8); c=np.zeros_like(dark)\n",
    "    for i in range(1,n):\n",
    "        x,y,w,hg,a=stats[i]\n",
    "        if 3<=a<=650 and w<=40 and hg<=40:c[lab==i]=True\n",
    "    k=np.ones((2*BAND_WIDTH+1,2*BAND_WIDTH+1),np.uint8); return cv2.dilate(h.astype(np.uint8),k)>0,cv2.dilate(v.astype(np.uint8),k)>0,cv2.dilate(c.astype(np.uint8),k)>0\n",
    "\n",
    "def geometry_t80(observed,mask,telea):\n",
    "    paper=background_surface(observed,mask); normalised=cv2.divide(observed,np.maximum(paper,1),scale=255); horizontal,vertical,compact=support_maps(observed,mask); m=mask>0; preserve=m&(horizontal|vertical|compact)&(observed<200); remove=m&~preserve&(observed>=GEOMETRY_THRESHOLD)&(normalised>=GEOMETRY_THRESHOLD); ambiguous=m&~preserve&~remove; result=observed.copy(); result[remove]=paper[remove]; result[ambiguous]=telea[ambiguous]; result[preserve]=observed[preserve]; return immutable(observed,result,mask),{'preserve':preserve,'remove':remove,'ambiguous':ambiguous,'horizontal':horizontal,'vertical':vertical,'compact':compact}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Execute paired mask-authority arms"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PROVENANCE: NEW V9.0A paired orchestration around the canonical correction functions.\n",
    "runtime={}; mask_rows=[]; output_rows=[]; edit_rows=[]\n",
    "for _,r in resolution.iterrows():\n",
    "    page=r.page; observed=read_gray(r.observed_path); raw=binary(read_gray(r.raw_yolo_mask_path)); reviewed=binary(read_gray(r.reviewed_mask_path)); confidence=np.load(r.confidence_map_path).astype(np.float32)\n",
    "    gated=np.where((raw>0)&(confidence>=ESTABLISHED_YOLO_GATE),255,0).astype(np.uint8)\n",
    "    arms={'reviewed_comparator':reviewed,'raw_yolo':raw,'confidence_gated_yolo':gated,'reviewer_corrected_yolo':reviewed.copy()}\n",
    "    runtime[page]={}; edit_rows.append({'page':page,'raw_pixels':int((raw>0).sum()),'reviewed_pixels':int((reviewed>0).sum()),'reviewer_additions':int(((reviewed>0)&(raw==0)).sum()),'reviewer_erasures':int(((reviewed==0)&(raw>0)).sum()),'raw_reviewed_xor':int(np.logical_xor(raw>0,reviewed>0).sum())})\n",
    "    for arm,seed in arms.items():\n",
    "        prepared=prepare_mask(seed); \n",
    "        telea=telea_reconstruct(observed,prepared); \n",
    "        corrected,routes=geometry_t80(observed,prepared,telea)\n",
    "        require(np.array_equal(corrected[prepared==0],observed[prepared==0]),f'{page}/{arm}: outside-mask drift')\n",
    "        md=MASKS/arm; md.mkdir(parents=True,exist_ok=True); cv2.imwrite(str(md/f'{page}.png'),seed)\n",
    "        d=OUTPUTS/arm/page; d.mkdir(parents=True,exist_ok=False)\n",
    "        for name,array in [('observed',observed),('authoritative_seed',seed),('prepared_mask',prepared),('telea',telea),('corrected',corrected),('route_preserve',routes['preserve'].astype(np.uint8)*255),('route_remove',routes['remove'].astype(np.uint8)*255),('route_ambiguous',routes['ambiguous'].astype(np.uint8)*255)]: cv2.imwrite(str(d/f'{name}.png'),array)\n",
    "        \n",
    "        runtime[page][arm] = {\n",
    "            'seed_path': str(md / f'{page}.png'),\n",
    "            'output_dir': str(d),\n",
    "            'seed_pixels': int((seed > 0).sum()),\n",
    "            'prepared_mask_pixels': int((prepared > 0).sum()),\n",
    "        }\n",
    "\n",
    "        mask_rows.append({'page':page,'arm':arm,'seed_pixels':int((seed>0).sum()),'prepared_mask_pixels':int((prepared>0).sum()),'seed_sha256':array_hash(seed),'prepared_mask_sha256':array_hash(prepared),'source_md5':r.source_md5})\n",
    "        output_rows.append({'page':page,'arm':arm,'corrected_sha256':array_hash(corrected),'outside_mask_drift':0,'changed_pixels':int((corrected!=observed).sum())})\n",
    "        del prepared\n",
    "        del telea\n",
    "        del corrected\n",
    "        del routes\n",
    "        gc.collect()\n",
    "\n",
    "    del observed\n",
    "    del raw\n",
    "    del reviewed\n",
    "    del confidence\n",
    "    del gated\n",
    "    del arms\n",
    "    gc.collect()\n",
    "    \n",
    "mask_manifest=pd.DataFrame(mask_rows); output_manifest=pd.DataFrame(output_rows); reviewer_edits=pd.DataFrame(edit_rows)\n",
    "mask_manifest.to_csv(LOCKS/'mask_arm_manifest.csv',index=False); output_manifest.to_csv(LOCKS/'corrected_output_manifest.csv',index=False); reviewer_edits.to_csv(SCORE/'reviewer_edits.csv',index=False)\n",
    "require(all(np.array_equal(runtime[p]['reviewed_comparator']['seed'],runtime[p]['reviewer_corrected_yolo']['seed']) for p in runtime),'Reviewed-role arms unexpectedly differ.')\n",
    "print('Pages:',len(runtime),'arm executions:',len(output_manifest))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Prediction and output lock"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PROVENANCE: project truth-firewall pattern.\n",
    "lock={'created_utc':datetime.now(timezone.utc).isoformat(),'pages':sorted(runtime),'source_md5_roster':resolution[['page','source_md5']].sort_values('page').to_dict('records'),'hitl_resolution_sha256':sha256_file(AUDIT/'hitl_input_resolution.csv'),'resolution_attempts_sha256':sha256_file(AUDIT/'notebook07_to_notebook06_resolution_attempts.csv'),'unresolved_lineages_sha256':sha256_file(AUDIT/'unresolved_review_lineages.csv'),'resolution_summary_sha256':sha256_file(AUDIT/'hitl_resolution_summary.json'),'yolo_gate_identity_sha256':sha256_file(AUDIT/'yolo_gate_identity.json'),'mask_manifest_sha256':sha256_file(LOCKS/'mask_arm_manifest.csv'),'output_manifest_sha256':sha256_file(LOCKS/'corrected_output_manifest.csv'),'truth_loaded':False}\n",
    "lock['lock_id']=object_hash(lock); atomic_json(LOCKS/'prediction_and_output_lock.json',lock)\n",
    "print('Lock ID:',lock['lock_id'])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Post-lock paired comparisons"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PROVENANCE:\n",
    "# V9.0A disk-backed paired comparison.\n",
    "#\n",
    "# Full-page arrays are deliberately NOT retained in `runtime`.\n",
    "# Each page/arm is loaded only for the comparison, then released.\n",
    "\n",
    "import gc\n",
    "\n",
    "\n",
    "def mask_metrics(candidate, reference):\n",
    "    c = candidate > 0\n",
    "    r = reference > 0\n",
    "\n",
    "    inter = int((c & r).sum())\n",
    "    union = int((c | r).sum())\n",
    "\n",
    "    return {\n",
    "        'iou': inter / max(union, 1),\n",
    "\n",
    "        'false_positive_pixels_vs_reviewed':\n",
    "            int((c & ~r).sum()),\n",
    "\n",
    "        'false_negative_pixels_vs_reviewed':\n",
    "            int((~c & r).sum()),\n",
    "\n",
    "        'xor_pixels':\n",
    "            int((c ^ r).sum()),\n",
    "    }\n",
    "\n",
    "\n",
    "rows = []\n",
    "\n",
    "for page in sorted(runtime):\n",
    "\n",
    "    # Load the reviewed comparator once for this page.\n",
    "    ref_mask = binary(\n",
    "        read_gray(\n",
    "            MASKS\n",
    "            / 'reviewed_comparator'\n",
    "            / f'{page}.png'\n",
    "        )\n",
    "    )\n",
    "\n",
    "    ref_out = read_gray(\n",
    "        OUTPUTS\n",
    "        / 'reviewed_comparator'\n",
    "        / page\n",
    "        / 'corrected.png'\n",
    "    )\n",
    "\n",
    "    for arm in ARMS:\n",
    "\n",
    "        candidate_mask = binary(\n",
    "            read_gray(\n",
    "                MASKS\n",
    "                / arm\n",
    "                / f'{page}.png'\n",
    "            )\n",
    "        )\n",
    "\n",
    "        candidate_out = read_gray(\n",
    "            OUTPUTS\n",
    "            / arm\n",
    "            / page\n",
    "            / 'corrected.png'\n",
    "        )\n",
    "\n",
    "        require(\n",
    "            candidate_mask.shape == ref_mask.shape,\n",
    "            (\n",
    "                f'{page}/{arm}: mask shape mismatch: '\n",
    "                f'{candidate_mask.shape} vs '\n",
    "                f'{ref_mask.shape}'\n",
    "            ),\n",
    "        )\n",
    "\n",
    "        require(\n",
    "            candidate_out.shape == ref_out.shape,\n",
    "            (\n",
    "                f'{page}/{arm}: corrected-output '\n",
    "                f'shape mismatch: '\n",
    "                f'{candidate_out.shape} vs '\n",
    "                f'{ref_out.shape}'\n",
    "            ),\n",
    "        )\n",
    "\n",
    "        q = mask_metrics(\n",
    "            candidate_mask,\n",
    "            ref_mask,\n",
    "        )\n",
    "\n",
    "        q.update({\n",
    "            'page': page,\n",
    "            'arm': arm,\n",
    "\n",
    "            'corrected_xor_pixels_vs_reviewed':\n",
    "                int(\n",
    "                    (\n",
    "                        candidate_out != ref_out\n",
    "                    ).sum()\n",
    "                ),\n",
    "\n",
    "            'corrected_mae_vs_reviewed':\n",
    "                float(\n",
    "                    np.abs(\n",
    "                        candidate_out.astype(\n",
    "                            np.int16\n",
    "                        )\n",
    "                        - ref_out.astype(\n",
    "                            np.int16\n",
    "                        )\n",
    "                    ).mean()\n",
    "                ),\n",
    "        })\n",
    "\n",
    "        rows.append(q)\n",
    "\n",
    "        # Release this arm immediately.\n",
    "        del candidate_mask\n",
    "        del candidate_out\n",
    "\n",
    "    # Release this page immediately.\n",
    "    del ref_mask\n",
    "    del ref_out\n",
    "\n",
    "    gc.collect()\n",
    "\n",
    "\n",
    "paired = pd.DataFrame(rows)\n",
    "\n",
    "require(\n",
    "    len(paired) == len(runtime) * len(ARMS),\n",
    "    (\n",
    "        'Paired comparison table is incomplete: '\n",
    "        f'expected {len(runtime) * len(ARMS)} rows, '\n",
    "        f'found {len(paired)}.'\n",
    "    ),\n",
    ")\n",
    "\n",
    "paired.to_csv(\n",
    "    SCORE / 'paired_mask_and_output_evidence.csv',\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "summary_df = (\n",
    "    paired\n",
    "    .groupby(\n",
    "        'arm',\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "        pages=(\n",
    "            'page',\n",
    "            'nunique',\n",
    "        ),\n",
    "\n",
    "        mean_mask_iou=(\n",
    "            'iou',\n",
    "            'mean',\n",
    "        ),\n",
    "\n",
    "        mask_false_positive_pixels=(\n",
    "            'false_positive_pixels_vs_reviewed',\n",
    "            'sum',\n",
    "        ),\n",
    "\n",
    "        mask_false_negative_pixels=(\n",
    "            'false_negative_pixels_vs_reviewed',\n",
    "            'sum',\n",
    "        ),\n",
    "\n",
    "        mask_xor_pixels=(\n",
    "            'xor_pixels',\n",
    "            'sum',\n",
    "        ),\n",
    "\n",
    "        corrected_xor_pixels=(\n",
    "            'corrected_xor_pixels_vs_reviewed',\n",
    "            'sum',\n",
    "        ),\n",
    "\n",
    "        corrected_mae_mean=(\n",
    "            'corrected_mae_vs_reviewed',\n",
    "            'mean',\n",
    "        ),\n",
    "    )\n",
    ")\n",
    "\n",
    "summary_df.to_csv(\n",
    "    SCORE / 'arm_summary.csv',\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "display(summary_df)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Optional clean-truth scoring after lock"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PROVENANCE: project clean-truth firewall.\n",
    "# Disk-backed bounded-memory version.\n",
    "#\n",
    "# Clean truth is loaded only after the prediction/output lock exists.\n",
    "# Corrected outputs and prepared masks are reloaded from disk rather\n",
    "# than retained in runtime.\n",
    "\n",
    "import gc\n",
    "\n",
    "require(\n",
    "    (LOCKS / 'prediction_and_output_lock.json').exists(),\n",
    "    'Prediction/output lock missing.'\n",
    ")\n",
    "\n",
    "clean_map = (\n",
    "    {\n",
    "        p.stem: p\n",
    "        for p in CLEAN_DIR.iterdir()\n",
    "        if p.is_file() and p.suffix.lower() in SUPPORTED\n",
    "    }\n",
    "    if CLEAN_DIR.exists()\n",
    "    else {}\n",
    ")\n",
    "\n",
    "truth_rows = []\n",
    "missing = []\n",
    "\n",
    "for page in sorted(runtime):\n",
    "\n",
    "    cp = clean_map.get(page)\n",
    "\n",
    "    if cp is None:\n",
    "        missing.append(page)\n",
    "        continue\n",
    "\n",
    "    clean = read_gray(cp)\n",
    "\n",
    "    for arm in ARMS:\n",
    "\n",
    "        corrected_path = (\n",
    "            OUTPUTS\n",
    "            / arm\n",
    "            / page\n",
    "            / 'corrected.png'\n",
    "        )\n",
    "\n",
    "        mask_path = (\n",
    "            OUTPUTS\n",
    "            / arm\n",
    "            / page\n",
    "            / 'prepared_mask.png'\n",
    "        )\n",
    "\n",
    "        require(\n",
    "            corrected_path.exists(),\n",
    "            f'{page}/{arm}: corrected output missing: '\n",
    "            f'{corrected_path}'\n",
    "        )\n",
    "\n",
    "        require(\n",
    "            mask_path.exists(),\n",
    "            f'{page}/{arm}: prepared mask missing: '\n",
    "            f'{mask_path}'\n",
    "        )\n",
    "\n",
    "        corrected = read_gray(corrected_path)\n",
    "\n",
    "        prepared_mask = binary(\n",
    "            read_gray(mask_path)\n",
    "        )\n",
    "\n",
    "        require(\n",
    "            clean.shape == corrected.shape,\n",
    "            (\n",
    "                f'{page}/{arm}: clean/output shape mismatch: '\n",
    "                f'{clean.shape} vs {corrected.shape}'\n",
    "            )\n",
    "        )\n",
    "\n",
    "        require(\n",
    "            clean.shape == prepared_mask.shape,\n",
    "            (\n",
    "                f'{page}/{arm}: clean/prepared-mask '\n",
    "                f'shape mismatch: '\n",
    "                f'{clean.shape} vs {prepared_mask.shape}'\n",
    "            )\n",
    "        )\n",
    "\n",
    "        diff = np.abs(\n",
    "            clean.astype(np.float32)\n",
    "            - corrected.astype(np.float32)\n",
    "        )\n",
    "\n",
    "        inside = prepared_mask > 0\n",
    "\n",
    "        truth_rows.append({\n",
    "            'page': page,\n",
    "            'arm': arm,\n",
    "\n",
    "            'whole_page_mae':\n",
    "                float(diff.mean()),\n",
    "\n",
    "            'inside_prepared_mask_mae':\n",
    "                (\n",
    "                    float(diff[inside].mean())\n",
    "                    if np.any(inside)\n",
    "                    else np.nan\n",
    "                ),\n",
    "\n",
    "            'prepared_mask_pixels':\n",
    "                int(inside.sum()),\n",
    "        })\n",
    "\n",
    "        # Release arm-sized arrays immediately.\n",
    "        del corrected\n",
    "        del prepared_mask\n",
    "        del diff\n",
    "        del inside\n",
    "\n",
    "    # Release the clean page before loading the next page.\n",
    "    del clean\n",
    "\n",
    "    gc.collect()\n",
    "\n",
    "\n",
    "if truth_rows:\n",
    "\n",
    "    truth_df = pd.DataFrame(truth_rows)\n",
    "\n",
    "    require(\n",
    "        len(truth_df)\n",
    "        == (len(runtime) - len(missing)) * len(ARMS),\n",
    "        (\n",
    "            'Clean-truth scoring table is incomplete: '\n",
    "            f'found {len(truth_df)} rows.'\n",
    "        )\n",
    "    )\n",
    "\n",
    "    truth_df.to_csv(\n",
    "        SCORE / 'postlock_clean_truth_scores.csv',\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "\n",
    "if missing:\n",
    "\n",
    "    pd.DataFrame({\n",
    "        'page_missing_clean_counterpart': missing\n",
    "    }).to_csv(\n",
    "        AUDIT / 'clean_truth_missing_pages.csv',\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    'Truth-scored pages:',\n",
    "    len(set(x['page'] for x in truth_rows)),\n",
    "    'missing clean:',\n",
    "    len(missing),\n",
    ")"
   ]
  },
