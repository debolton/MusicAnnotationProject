        "        d=OUTPUTS/arm/page; d.mkdir(parents=True,exist_ok=False)\n",
        "        for name,array in [('observed',observed),('authoritative_seed',seed),('prepared_mask',prepared),('telea',telea),('corrected',corrected),('route_preserve',routes['preserve'].astype(np.uint8)*255),('route_remove',routes['remove'].astype(np.uint8)*255),('route_ambiguous',routes['ambiguous'].astype(np.uint8)*255)]: cv2.imwrite(str(d/f'{name}.png'),array)\n",
        "\n",
        "        runtime[page][arm] = {\n",
        "            'seed_path': str(md / f'{page}.png'),\n",
        "            'output_dir': str(d),\n",
        "            'seed_pixels': int((seed > 0).sum()),\n",
        "            'prepared_mask_pixels': int((prepared > 0).sum()),\n",
        "        }\n",
        "\n",
        "        mask_rows.append({'page':page,'arm':arm,'seed_pixels':int((seed>0).sum()),'prepared_mask_pixels':int((prepared>0).sum()),'seed_sha256':array_hash(seed),'prepared_mask_sha256':array_hash(prepared),'source_md5':r.source_md5})\n",
        "        output_rows.append({'page':page,'arm':arm,'corrected_sha256':array_hash(corrected),'outside_mask_drift':0,'changed_pixels':int((corrected!=observed).sum())})\n",
        "        del prepared\n",
        "        del telea\n",
        "        del corrected\n",
        "        del routes\n",
        "        gc.collect()\n",
        "\n",
        "    del observed\n",
        "    del raw\n",
        "    del reviewed\n",
        "    del confidence\n",
        "    del gated\n",
        "    del arms\n",
        "    gc.collect()\n",
        "\n",
        "mask_manifest=pd.DataFrame(mask_rows); output_manifest=pd.DataFrame(output_rows); reviewer_edits=pd.DataFrame(edit_rows)\n",
        "mask_manifest.to_csv(LOCKS/'mask_arm_manifest.csv',index=False); output_manifest.to_csv(LOCKS/'corrected_output_manifest.csv',index=False); reviewer_edits.to_csv(SCORE/'reviewer_edits.csv',index=False)\n",
        "\n",
        "reviewed_hashes = (\n",
        "    mask_manifest[\n",
        "        mask_manifest['arm'].isin([\n",
        "            'reviewed_comparator',\n",
        "            'reviewer_corrected_yolo'\n",
        "        ])\n",
        "    ]\n",
        "    .pivot(\n",
        "        index='page',\n",
        "        columns='arm',\n",
        "        values='seed_sha256'\n",
        "    )\n",
        ")\n",
        "\n",
        "require(\n",
        "    reviewed_hashes[\n",
        "        'reviewed_comparator'\n",
        "    ].equals(\n",
        "        reviewed_hashes[\n",
        "            'reviewer_corrected_yolo'\n",
        "        ]\n",
        "    ),\n",
        "    'Reviewed-role arms unexpectedly differ.'\n",
        ")\n",
        "\n",
        "#require(all(np.array_equal(runtime[p]['reviewed_comparator']['seed'],runtime[p]['reviewer_corrected_yolo']['seed']) for p in runtime),'Reviewed-role arms unexpectedly differ.')\n",
        "print('Pages:',len(runtime),'arm executions:',len(output_manifest))"
      ],
