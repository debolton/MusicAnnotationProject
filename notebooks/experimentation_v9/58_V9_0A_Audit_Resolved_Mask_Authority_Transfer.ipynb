      "source": [
        "## 6. Canonical correction functions"
      ],
      "id": "THLM2JhwXVFJ"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "NvR9SFTZXVFJ"
      },
      "outputs": [],
      "source": [
        "# PROVENANCE: TRANSPLANTED from the canonical V7.8 block used by Notebook 09.\n",
        "def immutable(original,candidate,mask):\n",
        "    out=original.copy(); out[mask>0]=candidate[mask>0]; require(np.array_equal(out[mask==0],original[mask==0]),'Outside-mask drift'); return out\n",
        "\n",
        "def prepare_mask(seed,dilation=MASK_DILATION):\n",
        "    mask=binary(seed)\n",
        "    if dilation>0: mask=cv2.dilate(mask,cv2.getStructuringElement(cv2.MORPH_ELLIPSE,(2*dilation+1,2*dilation+1)))\n",
        "    return mask\n",
        "\n",
        "def padded_components(mask):\n",
        "    n,lab,stats,_=cv2.connectedComponentsWithStats((mask>0).astype(np.uint8),8); h,w=mask.shape; boxes=[]\n",
        "    for i in range(1,n):\n",
        "        x,y,bw,bh,area=stats[i]\n",
        "        if area>=8: boxes.append((max(0,x-CROP_MARGIN),max(0,y-CROP_MARGIN),min(w,x+bw+CROP_MARGIN),min(h,y+bh+CROP_MARGIN)))\n",
        "    changed=True\n",
        "    while changed:\n",
        "        changed=False; merged=[]\n",
        "        while boxes:\n",
        "            ax0,ay0,ax1,ay1=boxes.pop(); rest=[]\n",
        "            for bx0,by0,bx1,by1 in boxes:\n",
        "                if not (ax1<bx0 or bx1<ax0 or ay1<by0 or by1<ay0): ax0=min(ax0,bx0);ay0=min(ay0,by0);ax1=max(ax1,bx1);ay1=max(ay1,by1);changed=True\n",
        "                else: rest.append((bx0,by0,bx1,by1))\n",
        "            boxes=rest; merged.append((ax0,ay0,ax1,ay1))\n",
        "        boxes=merged\n",
        "    return boxes\n",
        "\n",
        "def telea_reconstruct(observed,mask):\n",
        "    result=observed.copy()\n",
        "    for x0,y0,x1,y1 in padded_components(mask):\n",
        "        im=observed[y0:y1,x0:x1]; mk=mask[y0:y1,x0:x1]; cand=cv2.inpaint(im,mk,3,cv2.INPAINT_TELEA); local=result[y0:y1,x0:x1]; local[mk>0]=cand[mk>0]\n",
        "    return immutable(observed,result,mask)\n",
        "\n",
        "def background_surface(observed,mask,sigma=45.0):\n",
        "    visible=(mask==0)&(observed>=200); values=observed.astype(np.float32)*visible; weights=visible.astype(np.float32); num=cv2.GaussianBlur(values,(0,0),sigma); den=cv2.GaussianBlur(weights,(0,0),sigma); fallback=cv2.GaussianBlur(observed,(0,0),sigma); return np.clip(np.where(den>0.02,num/np.maximum(den,1e-4),fallback),0,255).astype(np.uint8)\n",
        "\n",
        "def support_maps(observed,mask):\n",
        "    dark=(observed<190)&(mask==0); h=cv2.morphologyEx(dark.astype(np.uint8)*255,cv2.MORPH_OPEN,np.ones((1,35),np.uint8))>0; v=cv2.morphologyEx(dark.astype(np.uint8)*255,cv2.MORPH_OPEN,np.ones((15,1),np.uint8))>0; n,lab,stats,_=cv2.connectedComponentsWithStats(dark.astype(np.uint8),8); c=np.zeros_like(dark)\n",
        "    for i in range(1,n):\n",
        "        x,y,w,hg,a=stats[i]\n",
        "        if 3<=a<=650 and w<=40 and hg<=40:c[lab==i]=True\n",
        "    k=np.ones((2*BAND_WIDTH+1,2*BAND_WIDTH+1),np.uint8); return cv2.dilate(h.astype(np.uint8),k)>0,cv2.dilate(v.astype(np.uint8),k)>0,cv2.dilate(c.astype(np.uint8),k)>0\n",
        "\n",
        "def geometry_t80(observed,mask,telea):\n",
        "    paper=background_surface(observed,mask); normalised=cv2.divide(observed,np.maximum(paper,1),scale=255); horizontal,vertical,compact=support_maps(observed,mask); m=mask>0; preserve=m&(horizontal|vertical|compact)&(observed<200); remove=m&~preserve&(observed>=GEOMETRY_THRESHOLD)&(normalised>=GEOMETRY_THRESHOLD); ambiguous=m&~preserve&~remove; result=observed.copy(); result[remove]=paper[remove]; result[ambiguous]=telea[ambiguous]; result[preserve]=observed[preserve]; return immutable(observed,result,mask),{'preserve':preserve,'remove':remove,'ambiguous':ambiguous,'horizontal':horizontal,'vertical':vertical,'compact':compact}"
      ],
      "id": "NvR9SFTZXVFJ"
    },
