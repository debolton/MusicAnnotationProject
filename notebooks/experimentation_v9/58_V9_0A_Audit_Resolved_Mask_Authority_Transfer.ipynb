   "source": [
    "## 11. Visual audit queue"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PROVENANCE: NEW V9.0A visual audit.\n",
    "# Disk-backed bounded-memory version.\n",
    "\n",
    "import gc\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Build audit queue\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "queue = paired[\n",
    "    paired.arm.isin([\n",
    "        'raw_yolo',\n",
    "        'confidence_gated_yolo',\n",
    "    ])\n",
    "].copy()\n",
    "\n",
    "queue['priority'] = (\n",
    "    queue.corrected_xor_pixels_vs_reviewed\n",
    "    + 5 * queue.false_positive_pixels_vs_reviewed\n",
    "    + 3 * queue.false_negative_pixels_vs_reviewed\n",
    ")\n",
    "\n",
    "queue = queue.sort_values(\n",
    "    'priority',\n",
    "    ascending=False,\n",
    ").reset_index(drop=True)\n",
    "\n",
    "queue.to_csv(\n",
    "    SCORE / 'visual_audit_queue.csv',\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Faster resolution lookup\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "resolution_by_page = resolution.set_index('page')\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Create visual audit cases\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "for i, r in queue.head(30).iterrows():\n",
    "\n",
    "    page = str(r.page)\n",
    "    arm = str(r.arm)\n",
    "\n",
    "    require(\n",
    "        page in resolution_by_page.index,\n",
    "        f'{page}: missing from resolution table.'\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Load observed page\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    observed_path = Path(\n",
    "        resolution_by_page.loc[\n",
    "            page,\n",
    "            'observed_path'\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    require(\n",
    "        observed_path.exists(),\n",
    "        f'{page}: observed page missing: {observed_path}'\n",
    "    )\n",
    "\n",
    "    observed = read_gray(observed_path)\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Load authoritative seed masks\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    reviewed_mask_path = (\n",
    "        MASKS\n",
    "        / 'reviewed_comparator'\n",
    "        / f'{page}.png'\n",
    "    )\n",
    "\n",
    "    candidate_mask_path = (\n",
    "        MASKS\n",
    "        / arm\n",
    "        / f'{page}.png'\n",
    "    )\n",
    "\n",
    "    require(\n",
    "        reviewed_mask_path.exists(),\n",
    "        (\n",
    "            f'{page}: reviewed comparator mask missing: '\n",
    "            f'{reviewed_mask_path}'\n",
    "        )\n",
    "    )\n",
    "\n",
    "    require(\n",
    "        candidate_mask_path.exists(),\n",
    "        (\n",
    "            f'{page}/{arm}: candidate mask missing: '\n",
    "            f'{candidate_mask_path}'\n",
    "        )\n",
    "    )\n",
    "\n",
    "    reviewed = (\n",
    "        read_gray(reviewed_mask_path) > 0\n",
    "    )\n",
    "\n",
    "    candidate = (\n",
    "        read_gray(candidate_mask_path) > 0\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Load corrected outputs\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    reviewed_corrected_path = (\n",
    "        OUTPUTS\n",
    "        / 'reviewed_comparator'\n",
    "        / page\n",
    "        / 'corrected.png'\n",
    "    )\n",
    "\n",
    "    candidate_corrected_path = (\n",
    "        OUTPUTS\n",
    "        / arm\n",
    "        / page\n",
    "        / 'corrected.png'\n",
    "    )\n",
    "\n",
    "    require(\n",
    "        reviewed_corrected_path.exists(),\n",
    "        (\n",
    "            f'{page}: reviewed corrected output missing: '\n",
    "            f'{reviewed_corrected_path}'\n",
    "        )\n",
    "    )\n",
    "\n",
    "    require(\n",
    "        candidate_corrected_path.exists(),\n",
    "        (\n",
    "            f'{page}/{arm}: candidate corrected output missing: '\n",
    "            f'{candidate_corrected_path}'\n",
    "        )\n",
    "    )\n",
    "\n",
    "    reviewed_corrected = read_gray(\n",
    "        reviewed_corrected_path\n",
    "    )\n",
    "\n",
    "    candidate_corrected = read_gray(\n",
    "        candidate_corrected_path\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Shape checks\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    require(\n",
    "        observed.shape\n",
    "        == reviewed.shape\n",
    "        == candidate.shape\n",
    "        == reviewed_corrected.shape\n",
    "        == candidate_corrected.shape,\n",
    "        (\n",
    "            f'{page}/{arm}: visual-audit shape mismatch: '\n",
    "            f'observed={observed.shape}, '\n",
    "            f'reviewed={reviewed.shape}, '\n",
    "            f'candidate={candidate.shape}, '\n",
    "            f'reviewed_corrected={reviewed_corrected.shape}, '\n",
    "            f'candidate_corrected={candidate_corrected.shape}'\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Build mask-comparison overlay\n",
    "    #\n",
    "    # Green  = candidate and reviewer agree\n",
    "    # Orange = reviewer included, candidate missed\n",
    "    # Red    = candidate included, reviewer did not\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    overlap = reviewed & candidate\n",
    "    missed = reviewed & ~candidate\n",
    "    overreach = candidate & ~reviewed\n",
    "\n",
    "    overlay = cv2.cvtColor(\n",
    "        observed,\n",
    "        cv2.COLOR_GRAY2RGB,\n",
    "    )\n",
    "\n",
    "    overlay[overlap] = (\n",
    "        0,\n",
    "        180,\n",
    "        0,\n",
    "    )\n",
    "\n",
    "    overlay[missed] = (\n",
    "        255,\n",
    "        165,\n",
    "        0,\n",
    "    )\n",
    "\n",
    "    overlay[overreach] = (\n",
    "        255,\n",
    "        0,\n",
    "        0,\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Plot\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    fig, axes = plt.subplots(\n",
    "        1,\n",
    "        4,\n",
    "        figsize=(20, 7),\n",
    "    )\n",
    "\n",
    "    images = [\n",
    "        observed,\n",
    "        overlay,\n",
    "        reviewed_corrected,\n",
    "        candidate_corrected,\n",
    "    ]\n",
    "\n",
    "    titles = [\n",
    "        'Observed',\n",
    "        (\n",
    "            'Mask comparison\\n'\n",
    "            'green = overlap, '\n",
    "            'orange = candidate missed, '\n",
    "            'red = candidate overreach'\n",
    "        ),\n",
    "        'Reviewed comparator correction',\n",
    "        f'{arm} correction',\n",
    "    ]\n",
    "\n",
    "    for ax, image, title in zip(\n",
    "        axes,\n",
    "        images,\n",
    "        titles,\n",
    "    ):\n",
    "\n",
    "        if image.ndim == 2:\n",
    "            ax.imshow(\n",
    "                image,\n",
    "                cmap='gray',\n",
    "                vmin=0,\n",
    "                vmax=255,\n",
    "            )\n",
    "        else:\n",
    "            ax.imshow(image)\n",
    "\n",
    "        ax.set_title(title)\n",
    "        ax.axis('off')\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Add useful case metrics to title\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    fig.suptitle(\n",
    "        (\n",
    "            f'{page} | {arm}\\n'\n",
    "            f'Mask IoU={r.iou:.4f} | '\n",
    "            f'FP={int(r.false_positive_pixels_vs_reviewed):,} | '\n",
    "            f'FN={int(r.false_negative_pixels_vs_reviewed):,} | '\n",
    "            f'Corrected XOR='\n",
    "            f'{int(r.corrected_xor_pixels_vs_reviewed):,}'\n",
    "        ),\n",
    "        fontsize=12,\n",
    "    )\n",
    "\n",
    "    plt.tight_layout()\n",
    "\n",
    "    visual_path = (\n",
    "        VISUAL\n",
    "        / f'{i + 1:03d}_{page}_{arm}.png'\n",
    "    )\n",
    "\n",
    "    fig.savefig(\n",
    "        visual_path,\n",
    "        dpi=130,\n",
    "        bbox_inches='tight',\n",
    "    )\n",
    "\n",
    "    plt.close(fig)\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Release all page-sized arrays before next audit case\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    del observed\n",
    "    del reviewed\n",
    "    del candidate\n",
    "    del reviewed_corrected\n",
    "    del candidate_corrected\n",
    "\n",
    "    del overlap\n",
    "    del missed\n",
    "    del overreach\n",
    "    del overlay\n",
    "\n",
    "    del fig\n",
    "    del axes\n",
    "    del images\n",
    "\n",
    "    gc.collect()\n",
    "\n",
    "\n",
    "print(\n",
    "    'Visual cases:',\n",
    "    min(30, len(queue))\n",
    ")"
   ]
  },
