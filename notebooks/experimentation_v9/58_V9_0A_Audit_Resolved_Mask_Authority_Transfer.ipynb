    "## 12. Fail-closed verdict"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PROVENANCE: NEW V9.0A verdict.\n",
    "# A PASS means evidence package ready for review only.\n",
    "# It does NOT authorise automatic mask authority or production output.\n",
    "\n",
    "require(\n",
    "    (LOCKS / 'prediction_and_output_lock.json').exists(),\n",
    "    'Prediction/output lock missing before verdict.'\n",
    ")\n",
    "\n",
    "require(\n",
    "    (SCORE / 'paired_mask_and_output_evidence.csv').exists(),\n",
    "    'Paired comparison evidence missing before verdict.'\n",
    ")\n",
    "\n",
    "# Explicit roster expectation.\n",
    "expected_arms = {\n",
    "    'reviewed_comparator',\n",
    "    'raw_yolo',\n",
    "    'confidence_gated_yolo',\n",
    "    'reviewer_corrected_yolo',\n",
    "}\n",
    "\n",
    "manifest_arms = set(\n",
    "    mask_manifest['arm'].astype(str).unique()\n",
    ")\n",
    "\n",
    "checks = {\n",
    "    # These should ideally refer to actual earlier resolver/audit\n",
    "    # outcomes rather than being unconditional True.\n",
    "    'audit_resolver_single_version':\n",
    "        bool(len(resolution) > 0),\n",
    "\n",
    "    'canonical_page_identity_from_notebook07':\n",
    "        bool(\n",
    "            len(resolution) > 0\n",
    "            and resolution['page'].notna().all()\n",
    "            and ~resolution['page'].duplicated().any()\n",
    "        ),\n",
    "\n",
    "    'confidence_map_resolved_from_notebook06_audit':\n",
    "        bool(\n",
    "            'confidence_path' in resolution.columns\n",
    "            and resolution['confidence_path'].notna().all()\n",
    "        ),\n",
    "\n",
    "    # NOTE:\n",
    "    # This means the Notebook 06 detector/draft-mask threshold\n",
    "    # has been explicitly identified, not that a distinct\n",
    "    # higher-confidence mask-authority policy has been validated.\n",
    "    'established_detector_gate_explicit':\n",
    "        bool(\n",
    "            globals().get(\n",
    "                'NOTEBOOK06_RAW_YOLO_THRESHOLD',\n",
    "                None\n",
    "            ) is not None\n",
    "        ),\n",
    "\n",
    "    'all_resolved_pages_have_reviewed_masks':\n",
    "        bool(\n",
    "            'reviewed_mask_path' in resolution.columns\n",
    "            and resolution['reviewed_mask_path'].notna().all()\n",
    "        ),\n",
    "\n",
    "    'four_arm_roster_complete':\n",
    "        bool(\n",
    "            manifest_arms == expected_arms\n",
    "            and len(mask_manifest)\n",
    "                == len(resolution) * len(expected_arms)\n",
    "        ),\n",
    "\n",
    "    'zero_outside_mask_drift':\n",
    "        bool(\n",
    "            len(output_manifest) > 0\n",
    "            and (\n",
    "                output_manifest[\n",
    "                    'outside_mask_drift'\n",
    "                ] == 0\n",
    "            ).all()\n",
    "        ),\n",
    "\n",
    "    'prediction_output_lock_exists':\n",
    "        (\n",
    "            LOCKS\n",
    "            / 'prediction_and_output_lock.json'\n",
    "        ).exists(),\n",
    "\n",
    "    'paired_comparisons_written':\n",
    "        (\n",
    "            SCORE\n",
    "            / 'paired_mask_and_output_evidence.csv'\n",
    "        ).exists(),\n",
    "}\n",
    "\n",
    "\n",
    "first_failure = next(\n",
    "    (\n",
    "        k\n",
    "        for k, v in checks.items()\n",
    "        if not v\n",
    "    ),\n",
    "    None,\n",
    ")\n",
    "\n",
    "\n",
    "verdict = (\n",
    "    'PASS_V9_0A_EVIDENCE_PACKAGE_READY_FOR_REVIEW'\n",
    "    if first_failure is None\n",
    "    else 'FAIL_V9_0A_INVALID_RUN'\n",
    ")\n",
    "\n",
    "\n",
    "record = {\n",
    "    'created_utc':\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    'version':\n",
    "        '9.0A-audit-resolved-mask-authority-transfer',\n",
    "\n",
    "    'verdict':\n",
    "        verdict,\n",
    "\n",
    "    'first_failed_gate':\n",
    "        first_failure,\n",
    "\n",
    "    'checks':\n",
    "        checks,\n",
    "\n",
    "    'lock_id':\n",
    "        lock['lock_id'],\n",
    "\n",
    "    'resolved_pages':\n",
    "        len(resolution),\n",
    "\n",
    "    'unresolved_review_records':\n",
    "        len(unresolved),\n",
    "\n",
    "    'unresolved_lineage_policy':\n",
    "        UNRESOLVED_LINEAGE_POLICY,\n",
    "\n",
    "    # Explicit governance limits.\n",
    "    'automatic_mask_authority_authorised':\n",
    "        False,\n",
    "\n",
    "    'production_output_authority':\n",
    "        False,\n",
    "\n",
    "    'reviewed_mask_is_comparator_not_perfect_truth':\n",
    "        True,\n",
    "\n",
    "    'reviewed_comparator_and_reviewer_corrected_yolo_are_role_labels_for_the_same_pixels':\n",
    "        True,\n",
    "}\n",
    "\n",
    "\n",
    "atomic_json(\n",
    "    OUT / 'v9_0a_verdict.json',\n",
    "    record,\n",
    ")\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        record,\n",
    "        indent=2,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "if first_failure:\n",
    "    raise RuntimeError(\n",
    "        f'V9.0A failed at {first_failure}'\n",
    "    )"
   ]
