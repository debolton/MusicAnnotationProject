      "source": [
        "# PROVENANCE: project paths from Notebooks 06, 07 and 09; V9.0A-specific output layout.\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "import json, hashlib, shutil, zipfile, re, sys, platform\n",
        "import cv2\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import gc\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "ROOT = Path('/content/drive/MyDrive/MusicAnnotationProject')\n",
        "DRAFT_AUDIT_DIR = ROOT/'human_in_the_middle'/'draft_audit'\n",
        "REVIEW_AUDIT_DIR = ROOT/'human_in_the_middle'/'audit'\n",
        "CLEAN_DIR = ROOT/'source'/'clean'\n",
        "OUTPUT_ROOT = ROOT/'mask_authority_transfer_v9_0a'\n",
        "\n",
        "# Optional restriction using Notebook 07 PageXXX identities.\n",
        "PAGE_ALLOWLIST = None\n",
        "\n",
        "# Lineage policy:\n",
        "# - exclude_and_report: continue with resolvable reviewed pages and report every exclusion.\n",
        "# - require_complete: stop unless every Notebook 07 review audit resolves.\n",
        "UNRESOLVED_LINEAGE_POLICY = 'exclude_and_report'\n",
        "\n",
        "# Established Notebook 06 detector-confidence mask gate.\n",
        "# Do not substitute V8.2 observed-print probabilities here.\n",
        "NOTEBOOK06_RAW_YOLO_THRESHOLD = 0.20\n",
        "NOTEBOOK06_RAW_YOLO_POLICY_ID = 'Notebook06_PREDICTION_CONFIDENCE_0.20'\n",
        "\n",
        "# No separately evidenced higher confidence YOLO mask authority\n",
        "# threshold has been identified in the supplied project record.\n",
        "ESTABLISHED_YOLO_GATE = None\n",
        "ESTABLISHED_YOLO_GATE_POLICY_ID = None\n",
        "\n",
        "# Frozen canonical correction contract from the V7.8/Notebook 09 lineage.\n",
        "MASK_DILATION = 2\n",
        "CROP_MARGIN = 48\n",
        "GEOMETRY_THRESHOLD = 80\n",
        "BAND_WIDTH = 4\n",
        "\n",
        "RUN_ID = datetime.now().strftime('%Y%m%d_%H%M%S') + '_v9_0a_audit_resolved'\n",
        "OUT = OUTPUT_ROOT/'runs'/RUN_ID\n",
        "INPUTS=OUT/'01_inputs'; MASKS=OUT/'02_mask_arms'; OUTPUTS=OUT/'03_corrected_pages'\n",
        "LOCKS=OUT/'04_locks'; SCORE=OUT/'05_scoring'; VISUAL=OUT/'06_visual_audit'\n",
        "AUDIT=OUT/'07_audit'; UPLOAD=OUT/'upload'\n",
        "for p in [OUT,INPUTS,MASKS,OUTPUTS,LOCKS,SCORE,VISUAL,AUDIT,UPLOAD]:\n",
        "    p.mkdir(parents=True,exist_ok=False)\n",
        "\n",
        "ARMS=['reviewed_comparator','raw_yolo','confidence_gated_yolo','reviewer_corrected_yolo']\n",
        "SUPPORTED={'.png','.jpg','.jpeg','.tif','.tiff','.bmp'}\n",
        "print('Output:',OUT)"
      ],
