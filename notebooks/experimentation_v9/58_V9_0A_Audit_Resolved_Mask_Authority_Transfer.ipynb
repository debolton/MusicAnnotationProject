        "# PROVENANCE: NEW V9.0A comparison logic.\n",
        "def mask_metrics(candidate,reference):\n",
        "    c=candidate>0; r=reference>0; inter=int((c&r).sum()); union=int((c|r).sum()); return {'iou':inter/max(union,1),'false_positive_pixels_vs_reviewed':int((c&~r).sum()),'false_negative_pixels_vs_reviewed':int((~c&r).sum()),'xor_pixels':int((c^r).sum())}\n",
        "rows=[]\n",
        "for page,arms in runtime.items():\n",
        "    ref_mask = read_gray( MASKS / 'reviewed_comparator' / f'{page}.png' )\n",
        "    ref_out = read_gray( OUTPUTS / 'reviewed_comparator' / page / 'corrected.png' )\n",
        "    for arm,z in arms.items():\n",
        "        q=mask_metrics(z['seed'],ref_mask); q.update({'page':page,'arm':arm,'corrected_xor_pixels_vs_reviewed':int((z['corrected']!=ref_out).sum()),'corrected_mae_vs_reviewed':float(np.abs(z['corrected'].astype(np.int16)-ref_out.astype(np.int16)).mean())}); rows.append(q)\n",
        "paired=pd.DataFrame(rows); paired.to_csv(SCORE/'paired_mask_and_output_evidence.csv',index=False)\n",
        "summary_df=paired.groupby('arm',as_index=False).agg(pages=('page','nunique'),mean_mask_iou=('iou','mean'),mask_false_positive_pixels=('false_positive_pixels_vs_reviewed','sum'),mask_false_negative_pixels=('false_negative_pixels_vs_reviewed','sum'),mask_xor_pixels=('xor_pixels','sum'),corrected_xor_pixels=('corrected_xor_pixels_vs_reviewed','sum'),corrected_mae_mean=('corrected_mae_vs_reviewed','mean'))\n",
        "summary_df.to_csv(SCORE/'arm_summary.csv',index=False); display(summary_df)"
