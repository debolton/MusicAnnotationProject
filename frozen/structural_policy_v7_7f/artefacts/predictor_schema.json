  "allow_nan": true,
  "ignore_non_predictor_columns": true,
  "ordered_predictors": [
    "w",
    "h",
    "area",
    "aspect_ratio",
    "fill_ratio",
    "touches_page_border",
    "context_pixels",
    "context_edge_density",
    "context_dark_density",
    "context_mean_intensity",
    "context_intensity_std",
    "maximum_mask_depth",
    "horizontal_fraction",
    "vertical_fraction",
    "compact_fraction",
    "preserve_fraction",
    "remove_fraction",
    "ambiguous_fraction",
    "reconstruction_dependency_fraction",
    "component_pixels_x",
    "component_pixels_y"
