# modules/alignment/alignment_pipeline.py

import json

from pathlib import Path
from datetime import datetime, timezone

from modules.alignment.alignment_utils import (
    image_files,
    page_names,
    find_image,
    object_hash,
    create_overlay,
)

from modules.alignment.registration import (
    RegistrationEngine,
)

from modules.alignment.auto_mask import (
    AutoMaskGenerator,
)

from modules.alignment.alignment_state import (
    AlignmentStateManager,
)

import cv2
import numpy as np


class AlignmentPipeline:

    def __init__(
        self,
        config
    ):

        self.config = config

        self.root = Path(
            config["project_root"]
        )

        self.registration_config = (
            config["registration"]
        )

        self.auto_mask_config = (
            config["auto_mask"]
        )

        self.settings_hash = (
            object_hash(
                {
                    "registration":
                        self.registration_config,

                    "auto_mask":
                        self.auto_mask_config,
                }
            )
        )

        self._build_paths()

        self.registration = (
            RegistrationEngine(
                self.registration_config
            )
        )

        self.auto_mask = (
            AutoMaskGenerator(
                self.auto_mask_config
            )
        )

        self.state_manager = (
            AlignmentStateManager(
                state_path=
                self.state_path,

                settings_hash=
                self.settings_hash,
            )
        )

    # --------------------------------------------------
    # Paths
    # --------------------------------------------------

    def _build_paths(self):

        self.clean_dir = (
            self.root /
            "source" /
            "clean"
        )

        self.annotated_dir = (
            self.root /
            "source" /
            "annotated"
        )

        self.aligned_dir = (
            self.root /
            "aligned"
        )

        self.auto_mask_dir = (
            self.root /
            "masks" /
            "auto"
        )

        self.corrected_mask_dir = (
            self.root /
            "masks" /
            "corrected"
        )

        self.registration_review = (
            self.root /
            "review" /
            "registration"
        )

        self.auto_review = (
            self.root /
            "review" /
            "auto_masks"
        )

        self.state_dir = (
            self.root /
            "pipeline_state"
        )

        self.state_path = (
            self.state_dir /
            "notebook0_alignment_state.json"
        )

        for folder in [

            self.clean_dir,
            self.annotated_dir,
            self.aligned_dir,
            self.auto_mask_dir,
            self.corrected_mask_dir,
            self.registration_review,
            self.auto_review,
            self.state_dir,

        ]:

            folder.mkdir(
                parents=True,
                exist_ok=True,
            )

    # --------------------------------------------------
    # Page matching
    # --------------------------------------------------

    def matched_pages(self):

        clean = set(
            page_names(
                self.clean_dir
            )
        )

        annotated = set(
            page_names(
                self.annotated_dir
            )
        )

        matched = sorted(
            clean & annotated
        )

        if not matched:

            raise RuntimeError(
                "No matching clean "
                "and annotated pages."
            )

        return matched

    # --------------------------------------------------
    # Expected outputs
    # --------------------------------------------------

    def outputs_for_page(
        self,
        page
    ):

        return [

            self.aligned_dir
            / f"{page}.png",

            self.auto_mask_dir
            / f"{page}.png",

            self.registration_review
            / f"{page}_registration.png",

            self.registration_review
            / f"{page}_homography.npy",

            self.registration_review
            / f"{page}_registration.json",

            self.auto_review
            / f"{page}_strength.png",

            self.auto_review
            / f"{page}_overlay.png",

        ]

    # --------------------------------------------------
    # Output writing
    # --------------------------------------------------

    def save_outputs(
        self,
        page,
        aligned,
        homography,
        diagnostics,
        registration_preview,
        strength,
        mask,
    ):

        outputs = {

            "aligned":
                self.aligned_dir
                / f"{page}.png",

            "registration_preview":
                self.registration_review
                / f"{page}_registration.png",

            "homography":
                self.registration_review
                / f"{page}_homography.npy",

            "diagnostics":
                self.registration_review
                / f"{page}_registration.json",

            "auto_mask":
                self.auto_mask_dir
                / f"{page}.png",

            "strength":
                self.auto_review
                / f"{page}_strength.png",

            "auto_overlay":
                self.auto_review
                / f"{page}_overlay.png",
        }

        cv2.imwrite(
            str(outputs["aligned"]),
            aligned,
        )

        cv2.imwrite(
            str(
                outputs[
                    "registration_preview"
                ]
            ),
            registration_preview,
        )

        np.save(
            outputs["homography"],
            homography,
        )

        outputs[
            "diagnostics"
        ].write_text(

            json.dumps(
                diagnostics,
                indent=2
            )

        )

        cv2.imwrite(
            str(
                outputs[
                    "auto_mask"
                ]
            ),
            mask,
        )

        cv2.imwrite(
            str(
                outputs[
                    "strength"
                ]
            ),
            strength,
        )

        overlay = create_overlay(
            aligned,
            mask,
            0.55,
        )

        cv2.imwrite(
            str(
                outputs[
                    "auto_overlay"
                ]
            ),
            overlay,
        )

        return outputs

    # --------------------------------------------------
    # Main pipeline
    # --------------------------------------------------

    def run(self):

        self.state_manager.load()

        matched = (
            self.matched_pages()
        )

        clean_lookup = {}
        annotated_lookup = {}
        output_lookup = {}

        for page in matched:

            clean_lookup[page] = (
                find_image(
                    self.clean_dir,
                    page,
                )
            )

            annotated_lookup[page] = (
                find_image(
                    self.annotated_dir,
                    page,
                )
            )

            output_lookup[
                page
            ] = self.outputs_for_page(
                page
            )

        analysis = (
            self.state_manager
            .determine_pages(
                matched,
                clean_lookup,
                annotated_lookup,
                output_lookup,
            )
        )

        current_state = (
            analysis[
                "current_state"
            ]
        )

        to_process = (
            analysis[
                "to_process"
            ]
        )

        skipped = (
            analysis[
                "skipped"
            ]
        )

        processed = []
        failures = []

        for page in to_process:

            try:

                clean_path = (
                    clean_lookup[
                        page
                    ]
                )

                annotated_path = (
                    annotated_lookup[
                        page
                    ]
                )

                (
                    clean,
                    aligned,
                    H,
                    diagnostics,

                ) = (
                    self.registration
                    .align_pair(
                        clean_path,
                        annotated_path,
                    )
                )

                preview = (
                    self.registration
                    .registration_preview(
                        clean,
                        aligned,
                    )
                )

                (
                    strength,
                    mask,
                ) = (

                    self.auto_mask
                    .generate(
                        clean,
                        aligned,
                    )

                )

                outputs = (
                    self.save_outputs(
                        page,
                        aligned,
                        H,
                        diagnostics,
                        preview,
                        strength,
                        mask,
                    )
                )

                self.state_manager.update_success(

                    current_state,
                    page,
                    diagnostics,
                    outputs,
                )

                processed.append(
                    page
                )

                print(
                    "Processed:",
                    page
                )

            except Exception as ex:

                self.state_manager.update_failure(

                    current_state,
                    page,
                    ex,
                )

                failures.append(

                    (
                        page,
                        str(ex)
                    )

                )

                print(
                    "FAILED:",
                    page,
                    ex,
                )

        self.state_manager.save(
            current_state
        )

        return {

            "processed":
                processed,

            "skipped":
                skipped,

            "failures":
                failures,

            "state_file":
                str(
                    self.state_path
                ),
        }
